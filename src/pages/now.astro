---
import Container from "@/components/ui/Container.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`Now - ${SITE.title}`}
  description="What I'm doing right now."
  type="website"
  jsonLd={{ type: "website" }}
>
  <div class="w-full mx-auto flex grow flex-col">
    <section class="pt-16 pb-8">
      <Container class="flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <h1 class="text-[clamp(2rem,4vw,3rem)] font-medium tracking-tight leading-[1.1]">Now</h1>
          <p
            class="text-base leading-[calc(0.65rem+1em)]"
            style="color: var(--color-muted-foreground);"
          >
            What I'm doing right now.
          </p>
        </div>
      </Container>
    </section>

    <section class="pb-16">
      <Container class="flex flex-col gap-6">
        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Last updated: June 2026
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Working as a backend engineer at UST in Kochi, Kerala. Building backend systems with Java
          and Spring Boot.
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Currently learning [add what you're learning here].
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Reading [add book here].
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Working on [add project here].
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Listening to [add music/podcast here].
        </p>

        <p
          class="text-base leading-[calc(0.65rem+1em)]"
          style="color: var(--color-muted-foreground);"
        >
          Based in Kochi, Kerala. The weather is [add weather here].
        </p>
      </Container>
    </section>
  </div>
</Layout>
