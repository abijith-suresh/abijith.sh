---
import Container from "@/components/ui/Container.astro";
import PageShell from "@/components/ui/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { getStaticRouteMetadata } from "@/lib/route-metadata";

const routeMetadata = getStaticRouteMetadata("/now/");
---

<Layout>
  <PageShell title={routeMetadata.title} subtitle={routeMetadata.description}>
    <Container class="section-flow page-now rise" style="--d: 80ms">
      <p>last updated: august 2026</p>

      <p>
        still at <a
          href="https://ust.com"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">ust</a
        >, writing java.
      </p>

      <p>
        building — <a
          href="https://github.com/abijith-suresh/interleaf"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">interleaf</a
        >, a client-side pdf editor.
      </p>

      <p>
        playing — <a
          href="https://store.steampowered.com/app/2221490/Tom_Clancys_The_Division_2/"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">the division 2</a
        > and <a
          href="https://store.steampowered.com/app/2000950/Call_of_Duty_Modern_Warfare/"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">call of duty: modern warfare</a
        > (2019).
      </p>

      <p>
        watching — <a
          href="https://anilist.co/anime/161645/Kusuriya-no-Hitorigoto/"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">the apothecary diaries</a
        >.
      </p>

      <p>
        reading — <a
          href="https://www.goodreads.com/book/show/19776547-essentialism"
          class="text-link"
          target="_blank"
          rel="noopener noreferrer">essentialism</a
        > by greg mckeown.
      </p>
    </Container>
  </PageShell>
</Layout>

<style>
  /* readable measure inside the 64rem frame, left-aligned to the header */
  .page-now p {
    max-width: 38rem;
    color: var(--color-muted-foreground);
  }
</style>
