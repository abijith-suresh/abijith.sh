---
import type { ImageMetadata } from "astro";
import Container from "@/components/ui/Container.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import MediaCard from "@/components/MediaCard.astro";
import PageShell from "@/components/ui/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllWriting } from "@/lib/writing";
import { groupByYear } from "@/lib/group-by-year";
import { getStaticRouteMetadata } from "@/lib/route-metadata";
import { calculateReadingTime, formatDate, formatReadingTime } from "@/lib/utils";

const allPosts = await getAllWriting();
const postsByYear = groupByYear(allPosts, (post) => post.data.publishedDate);
const routeMetadata = getStaticRouteMetadata("/writing/");

const writingShots = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/writing/*.{webp,png,jpg,jpeg,avif}",
  { eager: true },
);
const findWritingShot = (id: string) =>
  Object.entries(writingShots).find(([path]) => path.includes(`/${id}.`))?.[1].default;
---

<Layout>
  <PageShell title={routeMetadata.title} subtitle={routeMetadata.description}>
    {
      allPosts.length > 0 ? (
        <Container>
          {postsByYear.map(({ year, items: yearPosts }) => (
            <div class="year-group">
              <span class="eyebrow">{year}</span>
              <div class="stack">
                {yearPosts.map((post, index) => (
                  <MediaCard
                    flip={index % 2 === 1}
                    href={`/writing/${post.id}/`}
                    title={post.data.title}
                    description={post.data.description}
                    meta={`${formatDate(post.data.publishedDate)} · ${formatReadingTime(calculateReadingTime(post.body ?? ""))}`}
                    image={findWritingShot(post.id)}
                    imageSrc={`/og/writing/${post.id}.png`}
                    placeholder={post.data.title.charAt(0)}
                    footLabel="read"
                  />
                ))}
              </div>
            </div>
          ))}
        </Container>
      ) : (
        <EmptyState message="No posts to display yet." />
      )
    }
  </PageShell>
</Layout>

<style>
  .year-group {
    padding-bottom: var(--content-gap);
  }

  .eyebrow {
    display: block;
    margin-bottom: var(--section-gap);
  }
</style>
