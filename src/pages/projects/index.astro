---
import type { ImageMetadata } from "astro";
import Container from "@/components/ui/Container.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import MediaCard from "@/components/MediaCard.astro";
import PageShell from "@/components/ui/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { groupByYear } from "@/lib/group-by-year";
import { getAllProjects } from "@/lib/projects";
import { getStaticRouteMetadata } from "@/lib/route-metadata";

const allProjects = await getAllProjects();
const projectsByYear = groupByYear(allProjects, (project) => project.data.publishedDate);
const routeMetadata = getStaticRouteMetadata("/projects/");

const projectShots = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/*.{webp,png,jpg,jpeg,avif}",
  { eager: true },
);
const findProjectShot = (id: string) =>
  Object.entries(projectShots).find(([path]) => path.includes(`/${id}.`))?.[1].default;
---

<Layout>
  <PageShell title={routeMetadata.title} subtitle={routeMetadata.description}>
    {
      allProjects.length > 0 ? (
        <Container>
          {projectsByYear.map(({ year, items: yearProjects }, yearIndex) => (
            <div class="year-group rise" style={`--d: ${160 + Math.min(yearIndex, 7) * 70}ms`}>
              <span class="eyebrow">{year}</span>
              <div class="stack">
                {yearProjects.map((project, index) => (
                  <MediaCard
                    flip={index % 2 === 1}
                    external
                    href={project.data.url ?? `https://github.com/abijith-suresh/${project.id}`}
                    title={project.data.title}
                    description={project.data.description}
                    placeholder={project.data.title.charAt(0)}
                    image={findProjectShot(project.id)}
                    browser={project.data.url ? new URL(project.data.url).hostname : undefined}
                    footLabel="visit"
                  />
                ))}
              </div>
            </div>
          ))}
        </Container>
      ) : (
        <EmptyState message="no projects to display yet." />
      )
    }
  </PageShell>
</Layout>

<style>
  .year-group {
    padding-bottom: var(--content-gap);
  }

  /* year labels are the page's accent moment — violet-tinted mono */
  .year-group > .eyebrow {
    display: block;
    margin-bottom: var(--section-gap);
    color: var(--color-primary);
  }
</style>
