---
import Container from "@/components/ui/Container.astro";
import { getAllBlogPosts } from "@/lib/blog";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";

const allPosts = await getAllBlogPosts();
const recentPosts = allPosts.slice(0, 5);
---

<Layout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{ type: "website" }}
>
  <div style="width:100%;margin-inline:auto;display:flex;flex-grow:1;flex-direction:column">
    <section style="padding-top:var(--spacing-16);padding-bottom:var(--spacing-8)">
      <Container class="section-flow">
        <div style="display:flex;flex-direction:column;gap:var(--spacing-3)">
          <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:500;letter-spacing:-0.025em;line-height:1.1">
            {SITE.author}
          </h1>
          <p
            style="font-size:var(--text-base);line-height:calc(0.65rem+1em);color:var(--color-muted-foreground)"
          >
            {SITE.role}
          </p>
        </div>
      </Container>
    </section>

    <section style="padding-bottom:var(--spacing-16)">
      <Container class="section-flow">
        <p
          style="font-size:var(--text-base);line-height:calc(0.65rem+1em);color:var(--color-muted-foreground)"
        >
          Backend engineer at <a
            href="https://ust.com"
            style="font-weight:500;color:var(--color-text)"
            target="_blank"
            rel="noopener noreferrer">UST</a
          >. I work on backend systems, mostly Java and Spring Boot. Currently building things and
          writing about them.
        </p>

        <p
          style="font-size:var(--text-base);line-height:calc(0.65rem+1em);color:var(--color-muted-foreground)"
        >
          You can see my <a href="/projects" style="font-weight:500;color:var(--color-text)"
            >projects</a
          >, read my <a href="/writing" style="font-weight:500;color:var(--color-text)">writing</a>, or
          check <a href="/now" style="font-weight:500;color:var(--color-text)">what I'm doing now</a>.
        </p>

        <p
          style="font-size:var(--text-base);line-height:calc(0.65rem+1em);color:var(--color-muted-foreground)"
        >
          Find me on{" "}
          <a
            href="https://github.com/abijith-suresh"
            style="font-weight:500;color:var(--color-text)"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >,{" "}
          <a
            href="https://x.com/abijith_sh"
            style="font-weight:500;color:var(--color-text)"
            target="_blank"
            rel="noopener noreferrer">X</a
          >,{" "}
          <a
            href="https://linkedin.com/in/abijith-suresh"
            style="font-weight:500;color:var(--color-text)"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >,{" "}
          <a
            href="https://bsky.app/profile/abijith.bsky.social"
            style="font-weight:500;color:var(--color-text)"
            target="_blank"
            rel="noopener noreferrer">Bluesky</a
          >,{" "}
          or subscribe via{" "}
          <a href="/rss.xml" style="font-weight:500;color:var(--color-text)">RSS</a>.
        </p>

        {
          recentPosts.length > 0 && (
            <div style="display:flex;flex-direction:column;gap:var(--spacing-3)">
              <p
                style="font-size:var(--text-base);line-height:calc(0.65rem+1em);color:var(--color-muted-foreground)"
              >
                Some recent writing:
              </p>
              <ul style="display:flex;flex-direction:column;gap:var(--spacing-2)">
                {recentPosts.map((post) => (
                  <li>
                    <a href={`/writing/${post.id}`} style="font-weight:500;color:var(--color-text)">
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </Container>
    </section>
  </div>
</Layout>
<style>
  .section-flow {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
</style>
