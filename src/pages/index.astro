---
import Hero from "@/components/Hero.astro";
import RecentPosts from "@/components/RecentPosts.astro";
import RecentProjects from "@/components/RecentProjects.astro";
import Container from "@/components/ui/Container.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{ type: "website" }}
>
  <div class="w-full mx-auto flex grow flex-col page-enter">
    <Hero />

    <section class="pb-16 page-enter page-enter-delay-1">
      <Container>
        <RecentProjects />
      </Container>
    </section>

    <section class="pb-16 page-enter page-enter-delay-2">
      <Container>
        <RecentPosts />
      </Container>
    </section>
  </div>
</Layout>
