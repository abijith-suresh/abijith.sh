---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Route 3 Soft Launchpad" description="Design exploration" type="website" noindex={true}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Karla:wght@400;600;800&family=Spline+Sans+Mono:wght@400;600&display=swap" />
  </Fragment>

  <div class="v3">
    <div class="v3__console">
      <header class="v3__hero v3__panel v3-rise" style="--d:0ms">
        <div class="v3__sun" aria-hidden="true"></div>
        <p class="v3__eyebrow">Route 03 // Soft Launchpad</p>
        <h1 class="v3__title">Small ships,<br />sunny systems.</h1>
        <p class="v3__lede">
          I&rsquo;m <strong>Abijith S</strong> &mdash; backend engineer in Kochi,
          working with Java and Spring Boot. This is a retro-future control
          panel for shipping tiny things with calm telemetry.
        </p>
        <ul class="v3__readouts" aria-label="Console readouts">
          <li><span>Status</span><strong>Ready</strong></li>
          <li><span>Stack</span><strong>Java &middot; Spring</strong></li>
          <li><span>Base</span><strong>Kochi &middot; IST</strong></li>
          <li><span>Shipped</span><strong>24 tiny</strong></li>
        </ul>
        <div class="v3__actions">
          <a class="v3__btn v3__btn--primary" href="https://skills.abijith.sh">skills.abijith.sh</a>
          <a class="v3__btn" href="https://prompts.abijith.sh">prompts.abijith.sh</a>
        </div>
      </header>

      <section class="v3__section v3-rise" style="--d:120ms" aria-labelledby="v3-tools">
        <h2 class="v3__h2" id="v3-tools">Tool cartridges</h2>
        <p class="v3__sub">Slot one in. Each tool is a self-contained cart with its own stack light.</p>
        <ul class="v3__carts">
          <li class="v3__cart v3__panel">
            <p class="v3__cart-top"><span class="v3__dot" aria-hidden="true"></span><span class="v3__mono">Cart 01 &middot; Live</span></p>
            <h3 class="v3__cart-name"><a href="https://skills.abijith.sh">Skills Index</a></h3>
            <p class="v3__mono v3__stack">Astro / Markdown</p>
            <p class="v3__cart-desc">Searchable field notes from backend work, kept sharp and short.</p>
          </li>
          <li class="v3__cart v3__panel">
            <p class="v3__cart-top"><span class="v3__dot v3__dot--teal" aria-hidden="true"></span><span class="v3__mono">Cart 02 &middot; Live</span></p>
            <h3 class="v3__cart-name"><a href="https://prompts.abijith.sh">Prompt Library</a></h3>
            <p class="v3__mono v3__stack">Markdown / Tags</p>
            <p class="v3__cart-desc">Copy-paste prompts that survive contact with real deadlines.</p>
          </li>
          <li class="v3__cart v3__panel">
            <p class="v3__cart-top"><span class="v3__dot" aria-hidden="true"></span><span class="v3__mono">Cart 03 &middot; Ready</span></p>
            <h3 class="v3__cart-name"><a href="#v3-log">Launch Checklist</a></h3>
            <p class="v3__mono v3__stack">Checklist / Karla</p>
            <p class="v3__cart-desc">Pre-flight for tiny releases: scope, rollback, announce.</p>
          </li>
        </ul>
      </section>

      <div class="v3__ribbon v3-rise" style="--d:200ms" aria-hidden="true">
        <span>Ship tiny &mdash; Stay sunny &mdash; Ship tiny &mdash; Stay sunny &mdash; Ship tiny &mdash; Stay sunny</span>
      </div>

      <section class="v3__section v3__panel v3-rise" style="--d:260ms" aria-labelledby="v3-log">
        <h2 class="v3__h2" id="v3-log">Console log</h2>
        <ul class="v3__log">
          <li><span class="v3__mono">01</span><div><a href="/projects/interleaf/">Interleaf</a><p>Lightweight page interleaving for long reads.</p></div><span class="v3__mono v3__tag">Stable</span></li>
          <li><span class="v3__mono">02</span><div><a href="/projects/reshrimp/">Reshrimp</a><p>Shrink-wrapped image pipeline for tiny sites.</p></div><span class="v3__mono v3__tag">Beta</span></li>
          <li><span class="v3__mono">03</span><div><a href="/projects/tailory/">Tailory</a><p>Cut-to-fit content snippets for portfolios.</p></div><span class="v3__mono v3__tag">Stable</span></li>
          <li><span class="v3__mono">04</span><div><a href="/projects/microbreak/">Microbreak</a><p>Gentle break timer that respects flow state.</p></div><span class="v3__mono v3__tag">WIP</span></li>
        </ul>
        <p class="v3__now"><span class="v3__mono">Now</span> Tuning Spring batch jobs in Kochi, sketching the next tiny launch.</p>
      </section>

      <section class="v3__section v3-rise" style="--d:320ms" aria-labelledby="v3-signals">
        <h2 class="v3__h2" id="v3-signals">Signals</h2>
        <ul class="v3__socials">
          <li><a href="https://github.com">GitHub</a></li>
          <li><a href="https://linkedin.com">LinkedIn</a></li>
          <li><a href="https://x.com">X</a></li>
          <li><a href="mailto:hello@abijith.sh">Email</a></li>
        </ul>
      </section>

      <footer class="v3__footer v3-rise" style="--d:380ms">
        <nav aria-label="Design explorations">
          <ul class="v3__routes">
            <li><a href="/1/">/1/</a></li>
            <li><a href="/2/">/2/</a></li>
            <li><a href="/4/">/4/</a></li>
            <li><a href="/5/">/5/</a></li>
          </ul>
        </nav>
        <p class="v3__mono v3__fine">Route 3 &middot; Soft Launchpad &middot; Sunny optimistic machine</p>
      </footer>
    </div>
  </div>

  <style>
    .v3 {
      --peach: #ffe3c7;
      --cream: #fff9f0;
      --orange: #ff6b2c;
      --teal: #0e7c7b;
      --plum: #46234e;
      background-color: var(--peach);
      background-image:
        radial-gradient(42rem 26rem at 12% 6%, rgba(255, 107, 44, 0.22), transparent 65%),
        radial-gradient(36rem 24rem at 88% 22%, rgba(14, 124, 123, 0.16), transparent 65%),
        radial-gradient(48rem 30rem at 50% 100%, rgba(255, 249, 240, 0.9), transparent 70%);
      background-attachment: fixed;
      color: var(--plum);
      font-family: "Karla", system-ui, sans-serif;
      padding: 3rem 1.25rem 4rem;
      position: relative;
      overflow: clip;
    }
    .v3::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(to bottom, rgba(70, 35, 78, 0.07) 0 1px, transparent 1px 5px);
      opacity: 0.5;
    }
    .v3__console { max-width: 56rem; margin: 0 auto; position: relative; z-index: 1; display: grid; gap: 2rem; }
    .v3__panel {
      background: var(--cream);
      border: 2px solid var(--plum);
      border-radius: 18px;
      box-shadow: inset 0 1px 0 #fff, inset 0 -10px 26px rgba(255, 107, 44, 0.14), 6px 6px 0 rgba(70, 35, 78, 0.14);
    }
    .v3__hero { position: relative; overflow: hidden; padding: 2.5rem 1.75rem; text-align: center; }
    .v3__sun {
      position: absolute; left: 50%; top: -14rem;
      width: 30rem; height: 30rem; transform: translateX(-50%);
      border-radius: 50%; border: 2px solid var(--plum);
      background: radial-gradient(circle at 50% 38%, #fff9f0 0%, #ffd9ae 42%, #ff9d5c 72%, #ff6b2c 100%);
      background-attachment: fixed;
      opacity: 0.9; z-index: 0;
    }
    .v3__hero > *:not(.v3__sun) { position: relative; z-index: 1; }
    .v3__eyebrow {
      display: inline-block; font-family: "Spline Sans Mono", monospace; font-size: 0.78rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      background: var(--plum); color: var(--cream);
      border: 2px solid var(--plum); border-radius: 999px; padding: 0.35rem 1rem;
    }
    .v3__title { font-family: "Shrikhand", serif; font-weight: 400; font-size: clamp(2.6rem, 7vw, 4.5rem); line-height: 1.02; margin: 1.2rem 0 0.8rem; }
    .v3__lede { max-width: 36rem; margin: 0 auto; font-size: 1.08rem; line-height: 1.6; }
    .v3__readouts {
      list-style: none; margin: 1.6rem auto 0; padding: 0.7rem;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem;
      background: var(--plum); border: 2px solid var(--plum); border-radius: 18px; max-width: 38rem;
    }
    .v3__readouts li { background: var(--cream); border-radius: 12px; padding: 0.6rem 0.4rem; display: grid; gap: 0.15rem; }
    .v3__readouts span { font-family: "Spline Sans Mono", monospace; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal); }
    .v3__readouts strong { font-family: "Spline Sans Mono", monospace; font-size: 0.86rem; }
    .v3__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 1.5rem; }
    .v3__btn {
      border: 2px solid var(--plum); border-radius: 999px; padding: 0.65rem 1.4rem;
      font-weight: 800; text-decoration: none; color: var(--plum); background: var(--cream);
    }
    .v3__btn--primary { background: var(--orange); color: var(--plum); }
    .v3__btn:hover { transform: translateY(-1px); }
    .v3__section { display: grid; gap: 0.7rem; }
    .v3__section.v3__panel { padding: 1.6rem; }
    .v3__h2 { font-family: "Spline Sans Mono", monospace; font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 0; }
    .v3__sub { margin: 0; opacity: 0.9; }
    .v3__mono { font-family: "Spline Sans Mono", monospace; }
    .v3__carts { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
    .v3__cart { padding: 1.1rem 1rem 1.25rem; display: grid; gap: 0.5rem; align-content: start; }
    .v3__cart::before { content: ""; height: 0.55rem; border: 2px solid var(--plum); border-radius: 999px; background: repeating-linear-gradient(to right, var(--plum) 0 0.6rem, transparent 0.6rem 1rem); opacity: 0.85; }
    .v3__cart-top { display: flex; align-items: center; gap: 0.55rem; margin: 0; font-size: 0.74rem; }
    .v3__dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--orange); border: 2px solid var(--plum); animation: v3-blink 1.6s steps(2, jump-none) infinite; flex: none; }
    .v3__dot--teal { background: var(--teal); animation-delay: 0.5s; }
    .v3__cart-name { margin: 0; font-size: 1.2rem; }
    .v3__cart-name a { color: inherit; }
    .v3__stack { margin: 0; font-size: 0.76rem; color: var(--teal); font-weight: 600; }
    .v3__cart-desc { margin: 0; line-height: 1.55; font-size: 0.96rem; }
    .v3__ribbon {
      transform: rotate(-2deg); background: var(--plum); color: var(--cream);
      border: 2px solid var(--plum); border-radius: 999px; overflow: hidden;
      font-family: "Spline Sans Mono", monospace; font-size: 0.8rem; letter-spacing: 0.1em;
      text-transform: uppercase; padding: 0.65rem 1rem; white-space: nowrap; text-align: center;
    }
    .v3__log { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; }
    .v3__log li {
      display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: baseline;
      padding: 0.9rem 0.2rem; border-top: 2px dashed rgba(70, 35, 78, 0.35);
    }
    .v3__log li:last-child { border-bottom: 2px dashed rgba(70, 35, 78, 0.35); }
    .v3__log a { font-weight: 800; color: inherit; font-size: 1.05rem; }
    .v3__log p { margin: 0.2rem 0 0; line-height: 1.5; }
    .v3__tag { background: var(--peach); border: 2px solid var(--plum); border-radius: 999px; padding: 0.15rem 0.7rem; font-size: 0.72rem; }
    .v3__now { margin: 0.8rem 0 0; background: var(--peach); border: 2px solid var(--plum); border-radius: 12px; padding: 0.8rem 1rem; line-height: 1.5; }
    .v3__now span { background: var(--teal); color: #fff; border-radius: 999px; padding: 0.1rem 0.6rem; font-size: 0.72rem; margin-right: 0.5rem; }
    .v3__socials { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; padding: 0; }
    .v3__socials a { display: inline-block; background: var(--cream); border: 2px solid var(--plum); border-radius: 999px; padding: 0.5rem 1.1rem; font-weight: 800; color: var(--plum); text-decoration: none; }
    .v3__socials a:hover, .v3__btn:hover, .v3__log a:hover, .v3__cart-name a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
    .v3 a:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; border-radius: 6px; }
    .v3__footer { display: grid; gap: 0.6rem; justify-items: center; text-align: center; }
    .v3__routes { list-style: none; display: flex; gap: 0.6rem; margin: 0; padding: 0; }
    .v3__routes a { font-family: "Spline Sans Mono", monospace; font-size: 0.85rem; background: var(--cream); border: 2px solid var(--plum); border-radius: 999px; padding: 0.4rem 0.95rem; color: var(--plum); text-decoration: none; font-weight: 600; }
    .v3__fine { margin: 0; font-size: 0.78rem; }
    .v3-rise { animation: v3-rise 0.7s ease both; animation-delay: var(--d, 0ms); }
    @keyframes v3-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes v3-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    @media (max-width: 46rem) {
      .v3__readouts { grid-template-columns: repeat(2, 1fr); }
      .v3__carts { grid-template-columns: 1fr; }
      .v3__hero { padding: 2rem 1.2rem; }
      .v3__sun { width: 22rem; height: 22rem; top: -10rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .v3-rise, .v3__dot { animation: none; }
      .v3__btn:hover { transform: none; }
    }
  </style>
</Layout>
