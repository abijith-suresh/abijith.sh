---
import BlogCard from "@/components/BlogCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SplitSection from "@/components/SplitSection.astro";
import Container from "@/components/ui/Container.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import PageShell from "@/components/ui/PageShell.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getAllBlogPosts } from "@/lib/blog";
import { getAllContentTags } from "@/lib/content-tags";
import { groupByYear } from "@/lib/group-by-year";
import { getAllProjects } from "@/lib/projects";
import { getTagHref, slugifyTag } from "@/lib/tags";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const [allContentTags, allPosts, allProjects] = await Promise.all([
    getAllContentTags(),
    getAllBlogPosts(),
    getAllProjects(),
  ]);

  return allContentTags.map(({ slug, label }) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags.some((tag) => slugifyTag(tag) === slug)
    );
    const filteredProjects = allProjects.filter((project) =>
      project.data.tags.some((tag) => slugifyTag(tag) === slug)
    );

    return {
      params: { tag: slug },
      props: {
        tagLabel: label,
        tagSlug: slug,
        posts: filteredPosts,
        projects: filteredProjects,
      },
    };
  });
}

interface Props {
  tagLabel: string;
  tagSlug: string;
  posts: CollectionEntry<"blog">[];
  projects: CollectionEntry<"projects">[];
}

const { tagLabel, tagSlug, posts, projects } = Astro.props;
const canonicalURL = new URL(getTagHref(tagSlug), SITE.url).href;

type ContentItem =
  | {
      type: "blog";
      date: Date;
      item: CollectionEntry<"blog">;
    }
  | {
      type: "project";
      date: Date;
      item: CollectionEntry<"projects">;
    };

const allContent: ContentItem[] = [
  ...posts.map(
    (post): ContentItem => ({
      type: "blog",
      date: post.data.publishDate,
      item: post,
    })
  ),
  ...projects.map(
    (project): ContentItem => ({
      type: "project",
      date: project.data.date,
      item: project,
    })
  ),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const contentByYear = groupByYear(allContent, (item) => item.date);
---

<Layout
  title={`Tag: ${tagLabel} - ${SITE.title}`}
  description={`Content tagged with "${tagLabel}"`}
  canonicalURL={canonicalURL}
  jsonLd={{ type: "website" }}
>
  <PageShell
    breadcrumbs={[
      { label: "Home", href: "/", icon: "fa6-solid:house" },
      { label: "Tags", href: "/tags", icon: "fa6-solid:tags" },
      { label: tagLabel, icon: "fa6-solid:tag" },
    ]}
    eyebrow="Tag"
    title={tagLabel}
  >
    {
      allContent.length > 0 ? (
        <Container class="flex flex-col gap-8">
          {contentByYear.map(({ year, items: yearContent }) => (
            <SplitSection label={String(year)}>
              <div class="flex flex-col gap-3">
                {yearContent.map(({ type, item }) =>
                  type === "blog" ? <BlogCard post={item} /> : <ProjectCard project={item} />
                )}
              </div>
            </SplitSection>
          ))}
        </Container>
      ) : (
        <EmptyState message="No content found with this tag." />
      )
    }
  </PageShell>
</Layout>
