---
const tones: Record<string, string> = {
  typescript: "tone-sky",
  pdf: "tone-amber",
  browser: "tone-mint",
  games: "tone-pink",
  puzzles: "tone-purple",
  ai: "tone-purple",
  prompts: "tone-amber",
  image: "tone-pink",
  "agent skills": "tone-mint",
  astro: "tone-amber",
  "open source": "tone-mint",
};

const projects = [
  {
    title: "Interleaf",
    href: "https://github.com/abijith-suresh/interleaf",
    description:
      "Client-side PDF manipulation tool - merge, split, reorder, rotate, and more",
    tags: ["typescript", "pdf", "browser"],
  },
  {
    title: "Microbreak",
    href: "https://github.com/abijith-suresh/microbreak",
    description: "Short, non-addictive puzzle games for build wait times.",
    tags: ["games", "puzzles", "browser"],
  },
  {
    title: "Prompts",
    href: "https://github.com/abijith-suresh/prompts",
    description:
      "A collection of reusable AI agent prompts for coding agents and chat applications",
    tags: ["ai", "prompts"],
  },
  {
    title: "Reshrimp",
    href: "https://github.com/abijith-suresh/reshrimp",
    description:
      "Client-side image manipulation tool - resize, compress, convert formats in your browser",
    tags: ["typescript", "image", "browser"],
  },
  {
    title: "Skills",
    href: "https://github.com/abijith-suresh/skills",
    description: "My personal collection of AI skills",
    tags: ["ai", "agent skills"],
  },
  {
    title: "Tailory",
    href: "https://github.com/abijith-suresh/tailory",
    description:
      "Client-side resume editor — upload, edit, preview, and export your resume as PDF. No account, no server, all local.",
    tags: ["astro", "open source"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abijith S — Design 1</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Design exploration /1 — soft signature, a light lavender take on abijith.sh"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@500,700,900&f[]=switzer@400,500,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <header class="site-header reveal" style="--d: 0ms">
      <div class="container">
        <nav class="nav" aria-label="Primary">
          <a class="brand" href="/">abijith.sh</a>
          <ul class="nav-links">
            <li><a class="nav-link" href="/writing/">writing</a></li>
            <li><a class="nav-link" href="/projects/">projects</a></li>
            <li><a class="nav-link" href="/about/">about</a></li>
            <li><a class="nav-link" href="/now/">now</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-label="Introduction">
        <h1 class="title reveal" style="--d: 80ms">
          hi, i'm <span class="chip">abijith</span>.
        </h1>
        <p class="intro reveal" style="--d: 160ms">
          Backend engineer at UST in Kochi, Kerala, India. I work with Java and
          Spring Boot. Outside work, I'm usually playing games or building
          something.
        </p>

        <ul class="socials reveal" style="--d: 240ms">
          <li>
            <a
              class="pill"
              href="https://github.com/abijith-suresh"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="pill-icon"
                aria-hidden="true"
                focusable="false"
                width="17"
                height="17"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                ></path>
              </svg>
              github
            </a>
          </li>
          <li>
            <a
              class="pill"
              href="https://x.com/abijith_sh"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="pill-icon"
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
                ></path>
              </svg>
              x
            </a>
          </li>
          <li>
            <a
              class="pill"
              href="https://linkedin.com/in/abijith-suresh"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="pill-icon"
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                ></path>
              </svg>
              linkedin
            </a>
          </li>
          <li>
            <a
              class="pill"
              href="https://bsky.app/profile/abijith.bsky.social"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="pill-icon"
                aria-hidden="true"
                focusable="false"
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 10.8C10.9 8.7 7.95 4.75 5.2 2.81 2.57 0.94 1.56 1.27 0.9 1.57 0.9 3.47 0.9 4.65 0.9 5.33 0.9 6.02 1.28 10.98 1.53 11.81 2.34 14.55 3.71 15.5 6.1 15.18 4 16.3 3.37 19 3.37 22.25 7.2 25.6 10.9 20.9 12 17.95 13.1 20.9 16.8 25.6 20.63 22.25 20.63 19 20 16.3 17.9 15.18 20.29 15.5 21.66 14.55 22.47 11.81 22.72 10.98 23.1 6.02 23.1 5.33 23.1 4.65 23.1 3.47 23.1 1.57 22.44 1.27 21.43 0.94 18.8 2.81 16.05 4.75 13.1 8.7 12 10.8Z"
                ></path>
              </svg>
              bluesky
            </a>
          </li>
          <li>
            <a class="pill" href="/rss.xml">
              <svg
                class="pill-icon"
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              >
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"></circle>
              </svg>
              rss
            </a>
          </li>
        </ul>
      </section>

      <div class="work container">
        <section class="reveal" style="--d: 320ms" aria-labelledby="projects-title">
          <h2 class="section-title" id="projects-title">projects</h2>
          <ul class="grid">
            {
              projects.map((project) => (
                <li>
                  <a
                    class="card"
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <h3 class="card-title">{project.title}</h3>
                    <p class="card-desc">{project.description}</p>
                    <ul class="tags">
                      {project.tags.map((tag) => (
                        <li class={`tag ${tones[tag]}`}>{tag}</li>
                      ))}
                    </ul>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="reveal" style="--d: 400ms" aria-labelledby="writing-title">
          <h2 class="section-title" id="writing-title">writing</h2>
          <a class="post-card" href="/writing/why-i-built-my-own-website/">
            <p class="post-date">feb 11, 2026</p>
            <h3 class="post-title">Why I Built My Own Website</h3>
            <p class="post-desc">
              On the value of owning your own corner of the internet, learning
              in public, and the satisfaction of building something for
              yourself.
            </p>
            <span class="read">read <span class="arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="all-link" href="/writing/">
            all writing <span class="arrow" aria-hidden="true">→</span>
          </a>
        </section>
      </div>
    </main>

    <footer class="site-footer reveal" style="--d: 460ms">
      <div class="container footer-inner">
        <p class="copyright">© 2026 abijith s</p>
        <p class="design-note">design 01 · soft signature</p>
      </div>
    </footer>

    <nav class="switcher" aria-label="Design switcher">
      <a href="/" aria-label="Design 0, current site">/</a>
      <a href="/1" aria-current="page" aria-label="Design 1, current page">1</a>
      <a href="/2" aria-label="Design 2">2</a>
      <a href="/3" aria-label="Design 3">3</a>
      <a href="/4" aria-label="Design 4">4</a>
      <a href="/5" aria-label="Design 5">5</a>
    </nav>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        --bg: oklch(97.8% 0.004 301);
        --text: oklch(36.5% 0.033 287);
        --muted: oklch(52.9% 0.038 291);
        --primary: oklch(61% 0.077 300);
        --link: oklch(52.5% 0.115 300);
        --pink: oklch(78.9% 0.08 360);
        --card: #ffffff;
        --hairline: rgba(0, 0, 0, 0.07);
        --ring: rgba(0, 0, 0, 0.05);
        --shadow-ink: rgba(24, 18, 46, 0.2);
        --font-display: "Satoshi", ui-sans-serif, system-ui, sans-serif;
        --font-body: "Switzer", ui-sans-serif, system-ui, sans-serif;
      }

      body {
        margin: 0;
        color: var(--text);
        font-family: var(--font-body);
        line-height: 1.6;
        background:
          radial-gradient(
            56rem 30rem at 12% -6rem,
            oklch(78.9% 0.08 360 / 0.13),
            transparent 62%
          ),
          radial-gradient(
            48rem 28rem at 88% -4rem,
            oklch(61% 0.077 300 / 0.09),
            transparent 60%
          ),
          var(--bg);
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: oklch(78.9% 0.08 360 / 0.45);
        color: var(--text);
      }

      :focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms;
          animation-iteration-count: 1;
          transition-duration: 0.01ms;
          scroll-behavior: auto;
        }
        .reveal {
          animation: none;
          opacity: 1;
          transform: none;
        }
      }
    </style>

    <style>
      .container {
        max-width: 64rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      }

      .reveal {
        animation: rise 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--d, 0ms);
      }

      .skip {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        transform: translateY(-300%);
        padding: 0.55rem 1rem;
        border: 1px solid var(--ring);
        border-radius: 999px;
        background: var(--card);
        color: var(--text);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 8px 24px -12px var(--shadow-ink);
      }
      .skip:focus {
        transform: none;
      }

      /* header */
      .site-header {
        padding-top: 1.5rem;
      }
      .nav {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
      }
      .brand {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
        text-decoration: none;
      }
      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .nav-link {
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 160ms ease;
      }
      .nav-link:hover {
        color: var(--text);
      }

      /* hero */
      .hero {
        padding-top: clamp(4.5rem, 10vw, 7rem);
      }
      .title {
        margin: 0;
        max-width: 14ch;
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 8vw, 4.2rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        text-wrap: balance;
      }
      .chip {
        display: inline-block;
        padding: 0 0.35em;
        border-radius: 1rem;
        background: oklch(78.9% 0.08 360 / 0.7);
      }
      .intro {
        margin: 1.5rem 0 0;
        max-width: 46ch;
        color: var(--muted);
        font-size: 1.075rem;
        line-height: 1.7;
        text-wrap: pretty;
      }
      .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 2.1rem 0 0;
        padding: 0;
        list-style: none;
      }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 1.05rem;
        border-radius: 999px;
        background: oklch(36.5% 0.033 287 / 0.06);
        color: var(--text);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 200ms ease;
      }
      .pill:hover {
        background: oklch(36.5% 0.033 287 / 0.1);
      }
      .pill-icon {
        flex: none;
        transition: transform 200ms ease;
      }
      .pill:hover .pill-icon {
        transform: translateX(2px);
      }

      /* sections */
      .work {
        display: grid;
        gap: clamp(3.5rem, 7vw, 5rem);
        margin-top: clamp(4.5rem, 9vw, 6.5rem);
      }
      .section-title {
        margin: 0 0 1.4rem;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.015em;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      @media (min-width: 640px) {
        .grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      .card {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.5rem;
        background: var(--card);
        border: 1px solid var(--ring);
        border-radius: 0.8rem;
        text-decoration: none;
        box-shadow: 0 1px 2px rgba(24, 18, 46, 0.04);
        transition:
          transform 200ms ease,
          box-shadow 200ms ease,
          border-color 200ms ease;
      }
      .card:hover {
        transform: translateY(-2px);
        border-color: rgba(0, 0, 0, 0.09);
        box-shadow:
          0 2px 4px rgba(24, 18, 46, 0.05),
          0 14px 32px -16px var(--shadow-ink);
      }
      .card-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
      }
      .card-desc {
        margin: 0.45rem 0 0;
        color: var(--muted);
        font-size: 0.925rem;
        line-height: 1.6;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: auto 0 0;
        padding-top: 1.15rem;
        list-style: none;
      }
      .tag {
        padding: 0.24rem 0.62rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.01em;
      }
      .tone-amber {
        background: oklch(92% 0.055 85);
        color: oklch(42% 0.095 70);
      }
      .tone-sky {
        background: oklch(92% 0.045 230);
        color: oklch(40% 0.095 245);
      }
      .tone-purple {
        background: oklch(92% 0.04 300);
        color: oklch(40% 0.125 300);
      }
      .tone-pink {
        background: oklch(92% 0.05 360);
        color: oklch(43% 0.12 360);
      }
      .tone-mint {
        background: oklch(92% 0.05 165);
        color: oklch(40% 0.09 170);
      }

      /* writing */
      .post-card {
        display: block;
        padding: 1.6rem;
        background: var(--card);
        border: 1px solid var(--ring);
        border-radius: 0.8rem;
        text-decoration: none;
        box-shadow: 0 1px 2px rgba(24, 18, 46, 0.04);
        transition:
          transform 200ms ease,
          box-shadow 200ms ease,
          border-color 200ms ease;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(0, 0, 0, 0.09);
        box-shadow:
          0 2px 4px rgba(24, 18, 46, 0.05),
          0 14px 32px -16px var(--shadow-ink);
      }
      .post-date {
        margin: 0;
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 500;
      }
      .post-title {
        margin: 0.5rem 0 0;
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--text);
      }
      .post-desc {
        margin: 0.55rem 0 0;
        max-width: 60ch;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
      }
      .read {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 1.1rem;
        color: var(--link);
        font-size: 0.9rem;
        font-weight: 600;
      }
      .arrow {
        transition: transform 200ms ease;
      }
      .post-card:hover .arrow,
      .all-link:hover .arrow {
        transform: translateX(3px);
      }
      .all-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.25rem;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 160ms ease;
      }
      .all-link:hover {
        color: var(--text);
      }

      /* footer */
      .site-footer {
        margin-top: clamp(4.5rem, 9vw, 6.5rem);
        border-top: 1px solid var(--hairline);
        padding: 1.75rem 0 6.5rem;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
      }
      .copyright {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .design-note {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
      }

      /* design switcher */
      .switcher {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 0.1rem;
        padding: 0.3rem;
        background: var(--card);
        border: 1px solid var(--ring);
        border-radius: 999px;
        box-shadow: 0 10px 30px -14px var(--shadow-ink);
      }
      .switcher a {
        padding: 0.34rem 0.62rem;
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        transition:
          background-color 160ms ease,
          color 160ms ease;
      }
      .switcher a:hover {
        background: rgba(0, 0, 0, 0.05);
        color: var(--text);
      }
      .switcher a[aria-current="page"] {
        background: var(--text);
        color: oklch(97.8% 0.004 301);
      }
    </style>
  </body>
</html>
