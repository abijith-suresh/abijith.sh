---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Route 1 Monsoon Newsroom" description="Design exploration" type="website" noindex={true}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
  </Fragment>

  <div class="v1">
    <header class="masthead">
      <p class="dateline">
        <span>Kochi, Kerala</span>
        <span aria-hidden="true">///</span>
        <span>Morning edition No. 001</span>
        <span aria-hidden="true">///</span>
        <span>Price, one smile</span>
      </p>
      <p class="brand">The Monsoon Post</p>
      <p class="subbrand">A warm morning paper from Kochi that files backend news and bad jokes</p>
    </header>

    <main>
      <section class="hero" aria-labelledby="v1-headline">
        <p class="kicker">Route 1 . Field report . Read in 2 minutes</p>
        <div class="hero-row">
          <h1 id="v1-headline" class="headline" aria-label="Systems that hold in heavy rain.">
            <span class="ch" style="--d:.02s" aria-hidden="true">S</span><span class="ch" style="--d:.06s" aria-hidden="true">y</span><span class="ch" style="--d:.10s" aria-hidden="true">s</span><span class="ch" style="--d:.14s" aria-hidden="true">t</span><span class="ch" style="--d:.18s" aria-hidden="true">e</span><span class="ch" style="--d:.22s" aria-hidden="true">m</span><span class="ch" style="--d:.26s" aria-hidden="true">s</span><span class="ch" style="--d:.30s" aria-hidden="true">&nbsp;</span><span class="ch" style="--d:.34s" aria-hidden="true">t</span><span class="ch" style="--d:.38s" aria-hidden="true">h</span><span class="ch" style="--d:.42s" aria-hidden="true">a</span><span class="ch" style="--d:.46s" aria-hidden="true">t</span><span class="ch" style="--d:.50s" aria-hidden="true">&nbsp;</span><br /><span class="ch" style="--d:.54s" aria-hidden="true">h</span><span class="ch" style="--d:.58s" aria-hidden="true">o</span><span class="ch" style="--d:.62s" aria-hidden="true">l</span><span class="ch" style="--d:.66s" aria-hidden="true">d</span><span class="ch" style="--d:.70s" aria-hidden="true">&nbsp;</span><span class="ch accent" style="--d:.74s" aria-hidden="true">i</span><span class="ch accent" style="--d:.78s" aria-hidden="true">n</span><span class="ch accent" style="--d:.82s" aria-hidden="true">&nbsp;</span><span class="ch accent" style="--d:.86s" aria-hidden="true">h</span><span class="ch accent" style="--d:.90s" aria-hidden="true">e</span><span class="ch accent" style="--d:.94s" aria-hidden="true">a</span><span class="ch accent" style="--d:.98s" aria-hidden="true">v</span><span class="ch accent" style="--d:1.02s" aria-hidden="true">y</span><span class="ch accent" style="--d:1.06s" aria-hidden="true">&nbsp;</span><span class="ch accent" style="--d:1.10s" aria-hidden="true">r</span><span class="ch accent" style="--d:1.14s" aria-hidden="true">a</span><span class="ch accent" style="--d:1.18s" aria-hidden="true">i</span><span class="ch accent" style="--d:1.22s" aria-hidden="true">n</span><span class="ch accent" style="--d:1.26s" aria-hidden="true">.</span>
          </h1>
          <p class="chop" role="img" aria-label="Printed in Kochi">Printed<br />in Kochi</p>
        </div>
        <p class="standfirst">I am Abijith S. I build backends in Kochi with Java and Spring Boot. I want quiet services that keep running while the rain hammers the windows.</p>
        <ul class="hero-links">
          <li><a href="https://skills.abijith.sh">skills.abijith.sh</a></li>
          <li><a href="https://prompts.abijith.sh">prompts.abijith.sh</a></li>
        </ul>
      </section>

      <div class="rule-perf" aria-hidden="true"><span>Cut along the rain</span></div>

      <section class="broadsheet" aria-labelledby="v1-bio">
        <h2 id="v1-bio" class="section-title">Staff bio, slightly damp</h2>
        <div class="cols">
          <p>Abijith S is a backend engineer in Kochi. His day job is Java, Spring Boot, queues that drain, and databases that forgive. He writes the kind of code you forget about, which is the point. Less paging, more chai.</p>
          <p>After hours he publishes small tools and notes. <a href="https://skills.abijith.sh">Skills</a> holds short engineering guides. <a href="https://prompts.abijith.sh">Prompts</a> holds reusable agent prompts. Both are plain, fast, and free of popups. He likes papers, ticket stubs, and software with margins.</p>
        </div>
        <blockquote class="pullquote">
          <p>If it survives monsoon traffic, it will survive anything.</p>
        </blockquote>
      </section>

      <section class="classifieds" aria-labelledby="v1-tools">
        <h2 id="v1-tools" class="section-title">Classifieds, tools for sale, price zero</h2>
        <ul class="ads">
          <li class="ad">
            <p class="ad-no">Issue No. 12</p>
            <h3><a href="https://skills.abijith.sh">Skills</a></h3>
            <p>Short backend guides. Postgres, Spring, and hard lessons, kept to one page each.</p>
            <p class="cut">Cut here <span aria-hidden="true">- - - - - - - -</span></p>
          </li>
          <li class="ad ad-mango">
            <p class="ad-no">Issue No. 07</p>
            <h3><a href="https://prompts.abijith.sh">Prompts</a></h3>
            <p>Copy paste prompts for coding agents. Tested on real tickets, not toy demos.</p>
            <p class="cut">Cut here <span aria-hidden="true">- - - - - - - -</span></p>
          </li>
          <li class="ad ad-leaf">
            <p class="ad-no">Issue No. 00</p>
            <h3>Wallpapers</h3>
            <p>Paper grain and rain maps for your desktop. Still drying. Back after the break.</p>
            <p class="cut">Soon <span aria-hidden="true">- - - - - - - -</span></p>
          </li>
        </ul>
      </section>

      <section class="index" aria-labelledby="v1-projects">
        <h2 id="v1-projects" class="section-title">News index, side projects</h2>
        <ul class="stories">
          <li><a href="#v1-projects"><strong>Interleaf</strong> <span>Plain text interleaved reading for long docs.</span> <em>Pg. 1</em></a></li>
          <li><a href="#v1-projects"><strong>Reshrimp</strong> <span>Tiny image resizer that keeps colors honest.</span> <em>Pg. 2</em></a></li>
          <li><a href="#v1-projects"><strong>Tailory</strong> <span>Changelog tailor that cuts release notes to size.</span> <em>Pg. 3</em></a></li>
          <li><a href="#v1-projects"><strong>Microbreak</strong> <span>Gentle break timer for people who skip breaks.</span> <em>Pg. 4</em></a></li>
        </ul>
      </section>

      <section class="now" aria-labelledby="v1-now">
        <h2 id="v1-now" class="section-title">Now filing</h2>
        <p>Now, shipping small Java services in Kochi and writing one honest page at a time. Rain outside, tests green inside.</p>
        <ul class="socials">
          <li><a href="https://github.com">GitHub</a></li>
          <li><a href="https://x.com">X</a></li>
          <li><a href="https://linkedin.com">LinkedIn</a></li>
          <li><a href="https://bsky.app">Bluesky</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </section>
    </main>

    <footer class="colophon">
      <p>Set in Fraunces and Newsreader. Printed on pixels that feel like paper. No trackers, no noise.</p>
      <nav aria-label="Design routes">
        <ul>
          <li><a href="/1/">1, you are here</a></li>
          <li><a href="/2/">2</a></li>
          <li><a href="/3/">3</a></li>
          <li><a href="/4/">4</a></li>
          <li><a href="/5/">5</a></li>
        </ul>
      </nav>
    </footer>
  </div>

  <style>
    .v1 {
      --paper: #FFF4E3;
      --ink: #2A201A;
      --chili: #D64520;
      --chili-ink: #96290E;
      --mango: #FFB21A;
      --leaf: #2F7D4F;
      --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --display: "Fraunces", Georgia, serif;
      --body: "Newsreader", Georgia, serif;
      background-color: var(--paper);
      background-image:
        repeating-linear-gradient(0deg, rgba(42,32,26,.055) 0 1px, transparent 1px 30px),
        repeating-linear-gradient(45deg, rgba(42,32,26,.025) 0 2px, transparent 2px 7px);
      color: var(--ink);
      font-family: var(--body);
      font-size: 1.125rem;
      line-height: 1.6;
      border-top: 6px solid var(--ink);
      border-bottom: 6px solid var(--ink);
    }
    .v1 ::selection { background: var(--mango); color: var(--ink); }
    .v1 a { color: var(--chili-ink); text-underline-offset: 3px; }
    .v1 a:hover { color: var(--chili); }
    .v1 a:focus-visible { outline: 3px solid var(--chili); outline-offset: 3px; border-radius: 4px; }
    .v1 .masthead, .v1 main, .v1 .colophon { max-width: 68rem; margin: 0 auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }
    .v1 .dateline {
      font-family: var(--mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
      display: flex; flex-wrap: wrap; gap: .6rem; justify-content: space-between;
      border-bottom: 2px solid var(--ink); padding: 1rem 0 .8rem; margin: 0;
    }
    .v1 .brand {
      font-family: var(--display); font-weight: 900; line-height: .9; letter-spacing: -0.02em;
      font-size: clamp(3rem, 10vw, 7.5rem); text-align: center; margin: 1.4rem 0 .4rem;
    }
    .v1 .subbrand { text-align: center; font-style: italic; margin: 0 0 1rem; font-size: 1.05rem; }
    .v1 .masthead::after { content: ""; display: block; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); height: 6px; }
    .v1 .kicker { font-family: var(--mono); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--chili-ink); margin: 2.2rem 0 1rem; }
    .v1 .hero-row { position: relative; }
    .v1 .headline {
      font-family: var(--display); font-weight: 900; line-height: .95; letter-spacing: -0.025em;
      font-size: clamp(2.8rem, 8vw, 6rem); margin: 0 0 1.2rem; max-width: 12ch;
    }
    .v1 .headline .accent { color: var(--chili); }
    .v1 .ch { display: inline-block; opacity: 0; animation: v1-stamp .4s cubic-bezier(.2, 1.5, .35, 1) forwards; animation-delay: var(--d, 0s); }
    .v1 .chop {
      position: absolute; right: clamp(0rem, 4vw, 3rem); top: -1.2rem;
      font-family: var(--mono); font-weight: 700; font-size: .85rem; line-height: 1.2; letter-spacing: .1em; text-transform: uppercase;
      text-align: center; color: var(--chili); border: 3px double var(--chili); border-radius: 4px;
      padding: .7rem .9rem; background: rgba(255,244,227,.85);
      transform: rotate(-6deg) scale(2); opacity: 0;
      animation: v1-slam .35s cubic-bezier(.2, 1.8, .3, 1) forwards; animation-delay: 1.55s;
    }
    .v1 .standfirst { font-size: 1.35rem; line-height: 1.45; max-width: 34ch; font-weight: 500; }
    .v1 .hero-links { list-style: none; display: flex; flex-wrap: wrap; gap: .7rem; padding: 0; margin: 1.2rem 0 2.4rem; font-family: var(--mono); font-size: .9rem; }
    .v1 .hero-links a { border: 2px solid var(--ink); border-radius: 4px; padding: .45rem .8rem; text-decoration: none; background: var(--paper); }
    .v1 .hero-links a:hover { background: var(--mango); color: var(--ink); }
    .v1 .rule-perf { border-top: 2px dashed var(--ink); border-bottom: 2px dashed var(--ink); padding: .4rem 0; text-align: center; font-family: var(--mono); font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; background: rgba(42,32,26,.04); }
    .v1 .section-title { font-family: var(--mono); font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; border-bottom: 2px solid var(--ink); padding-bottom: .5rem; margin: 2.6rem 0 1.2rem; }
    .v1 .broadsheet .cols { display: grid; gap: 1.2rem; }
    @media (min-width: 56rem) { .v1 .broadsheet .cols { grid-template-columns: 1fr 1fr; gap: 2rem; } }
    .v1 .broadsheet .cols p { margin: 0; }
    .v1 .pullquote {
      background: var(--mango); border: 2px solid var(--ink); border-radius: 4px;
      font-family: var(--display); font-weight: 600; font-size: clamp(1.4rem, 3.4vw, 2rem); line-height: 1.2;
      padding: 1.2rem 1.4rem; margin: 1.6rem -0.6rem 0; transform: rotate(-1.2deg);
      box-shadow: 6px 6px 0 var(--ink);
    }
    /* biome-ignore lint/style/noDescendingSpecificity: exploration cascade */
    .v1 .pullquote p { margin: 0; }
    .v1 .ads { list-style: none; display: grid; gap: 1rem; padding: 0; margin: 0; }
    @media (min-width: 56rem) { .v1 .ads { grid-template-columns: repeat(3, 1fr); } }
    .v1 .ad { border: 2px solid var(--ink); border-radius: 4px; padding: 1rem 1.1rem .8rem; background: #FFFBF1; }
    .v1 .ad-mango { background: #FFE3A1; }
    .v1 .ad-leaf { background: #DDEBDD; }
    .v1 .ad-no { font-family: var(--mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .5rem; }
    .v1 .ad h3 { font-family: var(--display); font-weight: 900; font-size: 1.5rem; margin: 0 0 .4rem; }
    .v1 .ad h3 a { color: var(--ink); }
    /* biome-ignore lint/style/noDescendingSpecificity: exploration cascade */
    .v1 .ad p { margin: 0 0 .6rem; font-size: 1rem; }
    .v1 .ad .cut { border-top: 2px dashed var(--ink); margin-top: .8rem; padding-top: .5rem; font-family: var(--mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
    .v1 .stories { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
    .v1 .stories li { border-bottom: 2px solid var(--ink); }
    .v1 .stories a { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; padding: .85rem .2rem; text-decoration: none; color: var(--ink); border-radius: 4px; }
    .v1 .stories a:hover { background: rgba(214,69,32,.1); }
    .v1 .stories strong { font-family: var(--display); font-weight: 900; font-size: 1.25rem; }
    .v1 .stories span { flex: 1 1 16ch; font-size: 1rem; }
    .v1 .stories em { font-family: var(--mono); font-style: normal; font-size: .8rem; color: var(--leaf); font-weight: 700; }
    /* biome-ignore lint/style/noDescendingSpecificity: exploration cascade */
    .v1 .now p { max-width: 52ch; }
    .v1 .socials { list-style: none; display: flex; flex-wrap: wrap; gap: .6rem; padding: 0; font-family: var(--mono); font-size: .88rem; }
    .v1 .socials a { border: 2px solid var(--ink); border-radius: 4px; padding: .35rem .7rem; text-decoration: none; }
    .v1 .socials a:hover { background: var(--ink); color: var(--paper); }
    .v1 .colophon { border-top: 2px solid var(--ink); margin-top: 2.5rem; padding-top: 1.2rem; padding-bottom: 2.5rem; display: grid; gap: 1rem; font-size: .95rem; }
    .v1 .colophon nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: .6rem; padding: 0; margin: 0; font-family: var(--mono); font-size: .88rem; }
    .v1 .colophon nav a { border: 2px solid var(--ink); border-radius: 4px; padding: .35rem .7rem; text-decoration: none; }
    @keyframes v1-stamp {
      0% { opacity: 0; transform: scale(1.7) rotate(-8deg); filter: blur(4px); }
      60% { opacity: 1; transform: scale(.96) rotate(1deg); filter: blur(0); }
      100% { opacity: 1; transform: scale(1) rotate(0); filter: blur(0); }
    }
    @keyframes v1-slam {
      0% { opacity: 0; transform: rotate(-6deg) scale(2.2); }
      60% { opacity: 1; transform: rotate(-6deg) scale(.94); }
      100% { opacity: 1; transform: rotate(-6deg) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .v1 .ch, .v1 .chop { animation: none; opacity: 1; transform: rotate(-6deg); filter: none; }
      .v1 .ch { transform: none; }
      .v1 * { scroll-behavior: auto; }
    }
  </style>
</Layout>
