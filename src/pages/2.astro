---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Route 2 Sticker Drawer"
  description="Design exploration"
  type="website"
  noindex={true}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Titan+One&family=Nunito:wght@400;700;800&family=Space+Mono:wght@400;700&display=swap" />
  </Fragment>

  <div class="v2">
    <div class="v2-ticker" aria-hidden="true">
      <div class="v2-ticker-track">
        <span>shipping tiny tools</span><span class="v2-dot">•</span>
        <span>backend toys</span><span class="v2-dot">•</span>
        <span>small + useful</span><span class="v2-dot">•</span>
        <span>shipping tiny tools</span><span class="v2-dot">•</span>
        <span>backend toys</span><span class="v2-dot">•</span>
        <span>small + useful</span><span class="v2-dot">•</span>
      </div>
    </div>

    <div class="v2-wrap">
      <header class="v2-hero">
        <p class="v2-kicker">Route 02 — Sticker drawer</p>
        <h1 class="v2-title">Shipping tiny tools!</h1>
        <p class="v2-sub"><strong>Abijith S</strong> — backend engineer in Kochi. Java + Spring Boot by day, toy-box builds by night.</p>
        <ul class="v2-pills" aria-label="Tool shelves">
          <li><a class="v2-pill v2-pill-coral" href="https://skills.abijith.sh">skills.abijith.sh</a></li>
          <li><a class="v2-pill v2-pill-grape" href="https://prompts.abijith.sh">prompts.abijith.sh</a></li>
        </ul>
        <p class="v2-badge" aria-hidden="true">100%<br />handmade</p>
        <span class="v2-star v2-s1" aria-hidden="true"></span>
        <span class="v2-star v2-s2" aria-hidden="true"></span>
        <span class="v2-star v2-s3" aria-hidden="true"></span>
      </header>

      <section class="v2-section" aria-labelledby="v2-tools-h">
        <h2 class="v2-h" id="v2-tools-h"><span class="v2-h-tag">Tools shelf</span> Fresh from the machine</h2>
        <ul class="v2-shelf">
          <li class="v2-sticker v2-tilt-a">
            <p class="v2-code">No. 01</p>
            <h3 class="v2-card-t">Skill files</h3>
            <p class="v2-card-p">Reusable working notes. Grab one, plug it in.</p>
            <a class="v2-mini" href="https://skills.abijith.sh">Open skills</a>
          </li>
          <li class="v2-sticker v2-tilt-b">
            <p class="v2-code">No. 02</p>
            <h3 class="v2-card-t">Prompt packs</h3>
            <p class="v2-card-p">Saved prompts that do one job well.</p>
            <a class="v2-mini" href="https://prompts.abijith.sh">Open prompts</a>
          </li>
          <li class="v2-sticker v2-tilt-a">
            <p class="v2-code">No. 03</p>
            <h3 class="v2-card-t">Micro utils</h3>
            <p class="v2-card-p">One-screen helpers. No signup, no bloat.</p>
            <a class="v2-mini" href="/projects/">See builds</a>
          </li>
        </ul>
      </section>

      <section class="v2-section" aria-labelledby="v2-work-h">
        <h2 class="v2-h" id="v2-work-h"><span class="v2-h-tag v2-h-tag-lime">Projects</span> Tilted + stacked</h2>
        <ul class="v2-stack">
          <li class="v2-card v2-tilt-a">
            <p class="v2-code">Pick 01 — Reading</p>
            <h3 class="v2-card-t">Interleaf</h3>
            <p class="v2-card-p">A quiet reading surface. Long-form first, chrome last.</p>
            <a class="v2-mini" href="/projects/#interleaf">View Interleaf</a>
          </li>
          <li class="v2-card v2-tilt-b">
            <p class="v2-code">Pick 02 — Utils</p>
            <h3 class="v2-card-t">Reshrimp</h3>
            <p class="v2-card-p">Small utilities that do one job and leave.</p>
            <a class="v2-mini" href="/projects/#reshrimp">View Reshrimp</a>
          </li>
          <li class="v2-card v2-tilt-a">
            <p class="v2-code">Pick 03 — Fit</p>
            <h3 class="v2-card-t">Tailory</h3>
            <p class="v2-card-p">Cut precisely, finish by hand. Experiments in fit.</p>
            <a class="v2-mini" href="/projects/#tailory">View Tailory</a>
          </li>
          <li class="v2-card v2-tilt-b">
            <p class="v2-code">Pick 04 — Rest</p>
            <h3 class="v2-card-t">Microbreak</h3>
            <p class="v2-card-p">Stand, stretch, look away. A tiny nudge.</p>
            <a class="v2-mini" href="/projects/#microbreak">View Microbreak</a>
          </li>
        </ul>
      </section>

      <section class="v2-now" aria-labelledby="v2-now-h">
        <h2 class="v2-h" id="v2-now-h">Now</h2>
        <p>Now: backend work at UST, evenings for side builds and drafts. <a href="/now/">Full now page</a></p>
      </section>

      <nav class="v2-socials" aria-label="Elsewhere">
        <h2 class="v2-h">Elsewhere</h2>
        <ul>
          <li><a href="https://github.com/abijith-suresh" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://x.com/abijith_sh" target="_blank" rel="noopener noreferrer">X</a></li>
          <li><a href="https://linkedin.com/in/abijith-suresh" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://bsky.app/profile/abijith.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>

      <footer class="v2-footer">
        <p>Route 02 toy box — keep browsing:</p>
        <ul aria-label="Design routes">
          <li><a href="/1/">/1/</a></li>
          <li><a href="/3/">/3/</a></li>
          <li><a href="/4/">/4/</a></li>
          <li><a href="/5/">/5/</a></li>
        </ul>
      </footer>
    </div>
  </div>

  <style>
    .v2 { --sky: #BFE9FF; --cream: #FFFBEB; --coral: #FF5D3A; --grape: #6C4CF1; --lime: #C8F04B; --ink: #211A30;
      --display: "Titan One", system-ui, sans-serif; --body: "Nunito", system-ui, sans-serif; --mono: "Space Mono", monospace;
      background: var(--sky); color: var(--ink); font-family: var(--body); flex: 1; width: 100%;
      background-image: radial-gradient(#211a3022 1.5px, transparent 1.5px); background-size: 22px 22px; }
    .v2 ::selection { background: var(--grape); color: #fff; }
    .v2-ticker { background: var(--ink); color: var(--cream); overflow: hidden; border-block: 3px solid var(--ink); }
    .v2-ticker-track { display: flex; gap: 1rem; width: max-content; padding: 0.6rem 1rem; font-family: var(--mono);
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
      animation: v2-marquee 18s linear infinite; }
    .v2-dot { color: var(--lime); }
    .v2-wrap { max-width: 62rem; margin-inline: auto; padding: 2.5rem 1.25rem 4rem; display: grid; gap: 2rem; }
    .v2-hero { position: relative; background: var(--cream); border-radius: 28px; padding: clamp(2rem, 6vw, 3.5rem);
      border: 3px solid var(--ink); box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--ink), 6px 6px 0 7px var(--ink);
      text-align: center; animation: v2-pop 0.5s ease both; }
    .v2-kicker { font-family: var(--mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; background: var(--lime); display: inline-block; padding: 0.4rem 0.9rem;
      border: 3px solid var(--ink); border-radius: 999px; box-shadow: 3px 3px 0 var(--ink); margin: 0 0 1rem; }
    .v2-title { font-family: var(--display); font-size: clamp(2.6rem, 8vw, 5rem); line-height: 0.95; margin: 0 0 1rem;
      text-wrap: balance; letter-spacing: 0.01em; }
    .v2-sub { font-size: 1.1rem; line-height: 1.6; max-width: 34rem; margin: 0 auto 1.5rem; }
    .v2-pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }
    .v2-pill { font-weight: 800; text-decoration: none; padding: 0.7rem 1.3rem; border-radius: 20px;
      border: 3px solid var(--ink); box-shadow: 0 0 0 3px #fff, 4px 4px 0 var(--ink); display: inline-block; color: var(--ink); }
    .v2-pill-coral { background: var(--coral); }
    .v2-pill-grape { background: var(--grape); color: #fff; }
    .v2-badge { position: absolute; top: -1.6rem; right: 1rem; width: 6.5rem; height: 6.5rem; margin: 0;
      display: grid; place-content: center; font-family: var(--display); font-size: 0.95rem; line-height: 1.1;
      background: var(--coral); color: var(--ink); border: 3px solid var(--ink); border-radius: 50%;
      box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--ink); transform: rotate(12deg); }
    .v2-star { position: absolute; width: 18px; height: 18px; background: var(--grape);
      clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); }
    .v2-s1 { left: 8%; top: 18%; } .v2-s2 { left: 14%; bottom: 14%; background: var(--coral); } .v2-s3 { right: 18%; bottom: 10%; background: var(--ink); }
    .v2-section { display: grid; gap: 1.25rem; }
    .v2-h { font-family: var(--mono); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0; text-align: center; }
    .v2-h-tag { background: var(--coral); border: 3px solid var(--ink); border-radius: 999px; padding: 0.25rem 0.8rem;
      box-shadow: 3px 3px 0 var(--ink); display: inline-block; margin-right: 0.5rem; }
    .v2-h-tag-lime { background: var(--lime); }
    .v2-shelf, .v2-stack { list-style: none; margin: 0; padding: 0.5rem 0.25rem 0.75rem; display: grid; gap: 1.5rem; }
    @media (min-width: 48rem) { .v2-shelf { grid-template-columns: repeat(3, 1fr); } .v2-stack { grid-template-columns: 1fr 1fr; } }
    .v2-sticker, .v2-card { background: var(--cream); border: 3px solid var(--ink); padding: 1.5rem 1.4rem;
      box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--ink), 6px 6px 0 7px var(--ink); animation: v2-pop 0.5s ease both; }
    .v2-sticker { border-radius: 24px; text-align: center; }
    .v2-card { border-radius: 20px; }
    .v2-tilt-a { transform: rotate(-2deg); } .v2-tilt-b { transform: rotate(2deg); }
    .v2-sticker:nth-child(2), .v2-card:nth-child(2) { animation-delay: 0.08s; }
    .v2-sticker:nth-child(3), .v2-card:nth-child(3) { animation-delay: 0.16s; }
    .v2-card:nth-child(4) { animation-delay: 0.24s; }
    .v2-code { font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; background: var(--lime); display: inline-block; margin: 0 0 0.8rem;
      padding: 0.25rem 0.7rem; border: 2px solid var(--ink); border-radius: 999px; }
    .v2-card:nth-child(even) .v2-code { background: var(--sky); }
    .v2-card-t { font-family: var(--display); font-size: 1.7rem; margin: 0 0 0.5rem; line-height: 1; }
    .v2-card-p { margin: 0 0 1rem; line-height: 1.6; font-size: 0.98rem; }
    .v2-mini { font-weight: 800; color: var(--ink); text-decoration: underline; text-decoration-thickness: 3px;
      text-decoration-color: var(--coral); text-underline-offset: 4px; border-radius: 6px; }
    .v2-card:nth-child(even) .v2-mini { text-decoration-color: var(--grape); }
    .v2-now { background: var(--ink); color: var(--cream); border-radius: 24px; padding: 1.5rem 1.75rem;
      border: 3px solid var(--ink); box-shadow: 0 0 0 4px #fff, 6px 6px 0 var(--ink); text-align: center; }
    .v2-now .v2-h { color: var(--lime); } .v2-now p { margin: 0.5rem 0 0; line-height: 1.6; }
    .v2-now a { color: var(--lime); font-weight: 800; }
    .v2-socials { background: var(--cream); border: 3px solid var(--ink); border-radius: 24px; padding: 1.5rem;
      box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--ink), 6px 6px 0 7px var(--ink); text-align: center; }
    .v2-socials ul { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
    .v2-socials ul a { font-weight: 800; color: var(--ink); text-decoration: none; background: #fff;
      border: 2px solid var(--ink); border-radius: 999px; padding: 0.45rem 1rem; box-shadow: 3px 3px 0 var(--ink); display: inline-block; }
    .v2-footer { text-align: center; font-family: var(--mono); font-size: 0.85rem; }
    .v2-footer p { margin: 0 0 0.75rem; } .v2-footer ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.7rem; justify-content: center; }
    .v2-footer ul a { font-weight: 700; color: var(--cream); background: var(--grape); text-decoration: none;
      border: 3px solid var(--ink); border-radius: 14px; padding: 0.4rem 0.9rem; box-shadow: 0 0 0 3px #fff, 4px 4px 0 var(--ink); display: inline-block; }
    .v2 a:focus-visible { outline: 3px solid var(--grape); outline-offset: 3px; }
    .v2-sticker:hover, .v2-card:hover, .v2-pill:hover, .v2-socials ul a:hover, .v2-footer ul a:hover { animation: v2-wobble 0.4s ease; }
    .v2-tilt-a:hover, .v2-tilt-b:hover { transform: rotate(0deg); }
    @keyframes v2-marquee { to { transform: translateX(-50%); } }
    @keyframes v2-pop { from { opacity: 0; transform: translateY(14px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes v2-wobble { 0% { rotate: 0deg; } 25% { rotate: -1.5deg; } 50% { rotate: 1.5deg; } 75% { rotate: -1deg; } 100% { rotate: 0deg; } }
    @media (prefers-reduced-motion: reduce) { .v2-ticker-track, .v2-hero, .v2-sticker, .v2-card { animation: none; }
      .v2-sticker:hover, .v2-card:hover, .v2-pill:hover { animation: none; } }
  </style>
</Layout>
