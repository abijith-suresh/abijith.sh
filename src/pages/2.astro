---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

const socials = [
  { label: "github", href: "https://github.com/abijith-suresh", external: true },
  { label: "x", href: "https://x.com/abijith_sh", external: true },
  { label: "linkedin", href: "https://linkedin.com/in/abijith-suresh", external: true },
  { label: "bluesky", href: "https://bsky.app/profile/abijith.bsky.social", external: true },
  { label: "rss", href: "/rss.xml", external: false },
];

const pages = [
  { label: "writing/", href: "/writing/" },
  { label: "projects/", href: "/projects/" },
  { label: "about/", href: "/about/" },
  { label: "now/", href: "/now/" },
];

const projects = [
  {
    title: "Interleaf",
    description: "Client-side PDF manipulation tool - merge, split, reorder, rotate, and more",
    tags: ["TypeScript", "PDF", "Browser"],
    slug: "interleaf",
  },
  {
    title: "Microbreak",
    description: "Short, non-addictive puzzle games for build wait times.",
    tags: ["Games", "Puzzles", "Browser"],
    slug: "microbreak",
  },
  {
    title: "Prompts",
    description: "A collection of reusable AI agent prompts for coding agents and chat applications",
    tags: ["AI", "Prompts"],
    slug: "prompts",
  },
  {
    title: "Reshrimp",
    description: "Client-side image manipulation tool - resize, compress, convert formats in your browser",
    tags: ["TypeScript", "Image", "Browser"],
    slug: "reshrimp",
  },
  {
    title: "Skills",
    description: "My personal collection of AI skills",
    tags: ["AI", "Agent Skills"],
    slug: "skills",
  },
  {
    title: "Tailory",
    description:
      "Client-side resume editor — upload, edit, preview, and export your resume as PDF. No account, no server, all local.",
    tags: ["Astro", "Open Source"],
    slug: "tailory",
  },
];

const designVersions = ["/", "/1", "/2", "/3", "/4", "/5"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abijith S — Design 2</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Design exploration 2 — terminal quiet. A mono-typography take on abijith.sh with a single phosphor accent." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <div class="wrap">
      <header class="hero">
        <p class="prompt reveal" style="--d: 0ms"><span class="ps1">$</span> ~/abijith</p>
        <h1 class="name reveal" style="--d: 70ms">abijith s<span class="cursor" aria-hidden="true">█</span></h1>
        <p class="role reveal" style="--d: 140ms">backend engineer — kochi, kerala · utc+5:30</p>
        <p class="bio reveal" style="--d: 210ms">
          I'm a backend engineer at UST in Kochi, Kerala. Most of my week goes into Java and
          Spring Boot services. Outside of work I'm usually playing games or building something.
        </p>
        <div class="connect reveal" style="--d: 280ms">
          <ul class="chips" aria-label="Profiles elsewhere">
            {
              socials.map((s) => (
                <li>
                  <a
                    class="chip"
                    href={s.href}
                    target={s.external ? "_blank" : undefined}
                    rel={s.external ? "noopener noreferrer" : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <nav class="pagenav" aria-label="Site pages">
            {pages.map((p) => <a href={p.href}>{p.label}</a>)}
          </nav>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <section class="block" aria-labelledby="projects-heading">
          <h2 class="label reveal" style="--d: 340ms" id="projects-heading">
            <span class="slash" aria-hidden="true">//</span> projects
          </h2>
          <ul class="rows">
            {
              projects.map((p, i) => (
                <li class="reveal" style={`--d: ${400 + i * 70}ms`}>
                  <a
                    class="row project"
                    href={`https://github.com/abijith-suresh/${p.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <span class="proj">
                      <span class="proj-title">{p.title}</span>
                      <span class="proj-desc">{p.description}</span>
                    </span>
                    <span class="tags">{p.tags.join(" · ")}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="block" aria-labelledby="writing-heading">
          <h2 class="label reveal" style="--d: 830ms" id="writing-heading">
            <span class="slash" aria-hidden="true">//</span> writing
          </h2>
          <ul class="rows">
            <li class="reveal" style="--d: 890ms">
              <a
                class="row post"
                href="/writing/why-i-built-my-own-website/"
                aria-label="2026-02-11 — Why I Built My Own Website"
              >
                <span class="date">2026-02-11</span>
                <span class="post">
                  <span class="post-title">why_i_built_my_own_website</span>
                  <span class="post-desc">
                    On the value of owning your own corner of the internet, learning in public,
                    and the satisfaction of building something for yourself.
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </section>
      </main>

      <footer class="foot">
        <p class="colophon reveal" style="--d: 960ms">abijith.sh — © 2026</p>
        <p class="status reveal" style="--d: 1020ms">
          <span class="dot" aria-hidden="true">●</span> all systems normal
        </p>
      </footer>
    </div>

    <nav class="switcher" aria-label="Design versions">
      {
        designVersions.map((v) => (
          <a href={v} aria-current={v === "/2" ? "page" : undefined}>
            {v}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<style is:global>
  :root {
    --bg: oklch(13.5% 0.004 260);
    --text: oklch(92% 0.005 260);
    --muted: oklch(64% 0.006 260);
    --dim: oklch(60% 0.006 260);
    --accent: oklch(82% 0.17 155);
    --hairline: rgb(255 255 255 / 0.09);
    --wash: rgb(255 255 255 / 0.04);
    --font-mono: "Geist Mono Variable", "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    --font-sans: "Geist Variable", "Geist", system-ui, "Segoe UI", sans-serif;
    --gutter: clamp(1.25rem, 5vw, 2.5rem);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background-color: var(--bg);
    background-image: radial-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 24px 24px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main:focus-visible {
    outline: none;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      transition-duration: 0.01ms;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 10;
    padding: 0.5rem 0.9rem;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.85rem;
  }

  .skip:focus-visible {
    top: 1rem;
  }

  .wrap {
    max-width: 60rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .reveal {
    animation: rise 360ms ease-out both;
    animation-delay: var(--d, 0ms);
  }

  /* hero */

  .hero {
    padding-top: clamp(5rem, 13vh, 8.5rem);
    padding-bottom: clamp(3rem, 7vh, 4.5rem);
  }

  .prompt {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .ps1 {
    color: var(--accent);
  }

  .name {
    margin: 0.9rem 0 1rem;
    font-size: clamp(2.2rem, 5.5vw + 1rem, 3.6rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cursor {
    color: var(--accent);
    margin-left: 0.12em;
    animation: blink 1.1s steps(2) infinite;
  }

  .role {
    margin: 0 0 2rem;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .bio {
    margin: 0 0 2.25rem;
    max-width: 52ch;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .connect {
    display: grid;
    gap: 1.1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-block;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 140ms ease, transform 140ms ease, border-color 140ms ease;
  }

  .chip::before {
    content: "[";
    color: var(--dim);
  }

  .chip::after {
    content: "]";
    color: var(--dim);
  }

  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateX(1px);
  }

  .pagenav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: 0.875rem;
  }

  .pagenav a {
    color: var(--dim);
    transition: color 140ms ease, transform 140ms ease;
  }

  .pagenav a:hover {
    color: var(--accent);
    transform: translateX(1px);
  }

  /* sections */

  .block {
    margin-top: clamp(3.5rem, 9vh, 5.5rem);
  }

  .label {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .slash {
    color: var(--accent);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li + li {
    border-top: 1px solid var(--hairline);
  }

  .rows li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-areas:
      "idx title"
      "idx desc"
      "idx tags";
    align-items: start;
    margin-inline: -0.75rem;
    padding: clamp(0.9rem, 2vw, 1.2rem) 0.75rem;
    transition: background-color 160ms ease;
  }

  .row:hover {
    background: var(--wash);
  }

  .idx {
    grid-area: idx;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--dim);
    transition: color 160ms ease;
  }

  .row:hover .idx {
    color: var(--accent);
  }

  .proj-title {
    grid-area: title;
    display: block;
    font-size: 1.05rem;
    font-weight: 450;
    color: var(--text);
  }

  .proj-desc {
    grid-area: desc;
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .tags {
    grid-area: tags;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--dim);
  }

  @media (min-width: 48rem) {
    .row.project {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      grid-template-areas:
        "idx title tags"
        "idx desc tags";
      column-gap: 1.5rem;
    }

    .tags {
      margin-top: 0.25rem;
      text-align: right;
    }
  }

  /* writing */

  .row.post {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-areas:
      "date title"
      "date desc";
  }

  .date {
    grid-area: date;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--dim);
  }

  .post {
    display: contents;
  }

  .post-title {
    grid-area: title;
    font-size: 1.05rem;
    font-weight: 450;
    color: var(--text);
    transition: color 160ms ease;
  }

  .row.post:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    grid-area: desc;
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .row.post {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      grid-template-areas:
        "date title"
        "date desc";
      column-gap: 1.5rem;
    }
  }

  /* footer */

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    margin-top: clamp(3.5rem, 9vh, 5.5rem);
    padding: 1.75rem 0 5rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.8rem;
    color: var(--dim);
  }

  .foot p {
    margin: 0;
  }

  .dot {
    color: var(--accent);
    animation: pulse 2.4s ease-in-out infinite alternate;
  }

  @keyframes pulse {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.55;
    }
  }

  /* design switcher */

  .switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 5;
    display: flex;
    gap: 0.1rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    backdrop-filter: blur(4px);
    font-size: 0.72rem;
  }

  .switcher a {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.3rem;
    color: var(--dim);
    transition: color 140ms ease;
  }

  .switcher a:hover {
    color: var(--accent);
  }

  .switcher a[aria-current="page"] {
    color: var(--accent);
  }

  .switcher a[aria-current="page"]::before {
    content: "[";
    color: var(--accent);
  }

  .switcher a[aria-current="page"]::after {
    content: "]";
    color: var(--accent);
  }
</style>
