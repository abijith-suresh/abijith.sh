---
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";

const projects = [
  {
    index: "P.01",
    title: "Interleaf",
    description:
      "Client-side PDF manipulation tool - merge, split, reorder, rotate, and more",
    date: "2026-02-16",
    tags: ["typescript", "pdf", "browser"],
    href: "https://github.com/abijith-suresh/interleaf",
  },
  {
    index: "P.02",
    title: "Microbreak",
    description: "Short, non-addictive puzzle games for build wait times.",
    date: "2026-04-24",
    tags: ["games", "puzzles", "browser"],
    href: "https://github.com/abijith-suresh/microbreak",
  },
  {
    index: "P.03",
    title: "Prompts",
    description:
      "A collection of reusable AI agent prompts for coding agents and chat applications",
    date: "2026-05-16",
    tags: ["ai", "prompts"],
    href: "https://github.com/abijith-suresh/prompts",
  },
  {
    index: "P.04",
    title: "Reshrimp",
    description:
      "Client-side image manipulation tool - resize, compress, convert formats in your browser",
    date: "2026-02-08",
    tags: ["typescript", "image", "browser"],
    href: "https://github.com/abijith-suresh/reshrimp",
  },
  {
    index: "P.05",
    title: "Skills",
    description: "My personal collection of AI skills",
    date: "2026-03-01",
    tags: ["ai", "agent skills"],
    href: "https://github.com/abijith-suresh/skills",
  },
  {
    index: "P.06",
    title: "Tailory",
    description:
      "Client-side resume editor — upload, edit, preview, and export your resume as PDF. No account, no server, all local.",
    date: "2026-03-01",
    tags: ["astro", "open source"],
    href: "https://github.com/abijith-suresh/tailory",
  },
];

const socials = [
  { label: "github", href: "https://github.com/abijith-suresh", external: true },
  { label: "x", href: "https://x.com/abijith_sh", external: true },
  { label: "linkedin", href: "https://linkedin.com/in/abijith-suresh", external: true },
  { label: "bluesky", href: "https://bsky.app/profile/abijith.bsky.social", external: true },
  { label: "rss", href: "/rss.xml", external: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Abijith S — Design 4</title>
    <meta
      name="description"
      content="Design exploration /4 — Grid Marker. Swiss grid discipline with the scaffolding visible."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <span class="mark m-tl" aria-hidden="true">+</span>
    <span class="mark m-tr" aria-hidden="true">+</span>
    <span class="mark m-bl" aria-hidden="true">+</span>
    <span class="mark m-br" aria-hidden="true">+</span>

    <header class="masthead reveal">
      <div class="wrap">
        <p class="brand"><a href="/">Abijith S</a></p>
        <nav aria-label="Pages">
          <a href="/about/">About</a>
          <a href="/now/">Now</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="sec" id="index" aria-labelledby="index-label">
        <div class="wrap">
          <div class="sechead reveal" style="--d: 55ms">
            <h2 class="label" id="index-label"><span class="no">01</span> — Index</h2>
            <p class="count">9.9312° N, 76.2673° E</p>
          </div>
          <h1 class="reveal" style="--d: 110ms">
            Backend engineer in Kochi. I build tools that stay fast and private<span
              class="dot">.</span
            >
          </h1>
          <p class="meta reveal" style="--d: 165ms">Java · Spring Boot · UST · Kochi, IN</p>
          <p class="lede reveal" style="--d: 220ms">
            Outside work: playing games or building something.
          </p>
        </div>
      </section>

      <section class="sec" id="projects" aria-labelledby="projects-label">
        <div class="wrap">
          <div class="sechead reveal" style="--d: 100ms">
            <h2 class="label" id="projects-label"><span class="no">02</span> — Projects</h2>
            <p class="count">6 repos</p>
          </div>
          <div class="pgrid">
            {projects.map((p, i) => (
              <a
                class="card reveal"
                style={`--d: ${150 + i * 55}ms`}
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="card-top">
                  <span>{p.index}</span>
                  <span>{p.date}</span>
                </div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
                <div class="tags">
                  {p.tags.map((t) => (
                    <span>[{t}]</span>
                  ))}
                </div>
                <div class="card-foot"><span>GitHub ↗</span></div>
              </a>
            ))}
            <a
              class="cell-util reveal"
              style="--d: 460ms"
              href="https://github.com/abijith-suresh"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>GitHub — all repos</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
            <a class="cell-util reveal" style="--d: 480ms" href="/projects/">
              <span>All projects</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="sec" id="writing" aria-labelledby="writing-label">
        <div class="wrap">
          <div class="sechead reveal" style="--d: 145ms">
            <h2 class="label" id="writing-label"><span class="no">03</span> — Writing</h2>
            <p class="count">1 post</p>
          </div>
          <div class="rows">
            <a class="row reveal" style="--d: 200ms" href="/writing/why-i-built-my-own-website/">
              <span class="date">2026-02-11</span>
              <div class="rowmain">
                <h3>Why I Built My Own Website</h3>
                <p class="desc">
                  On the value of owning your own corner of the internet, learning in public, and
                  the satisfaction of building something for yourself.
                </p>
              </div>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
            <a class="row allrow reveal" style="--d: 240ms" href="/writing/">
              <span class="alllabel">All writing ↗</span>
              <span class="allpath">/writing/</span>
            </a>
          </div>
        </div>
      </section>

      <section class="sec" id="elsewhere" aria-labelledby="elsewhere-label">
        <div class="wrap">
          <div class="sechead reveal" style="--d: 190ms">
            <h2 class="label" id="elsewhere-label"><span class="no">04</span> — Elsewhere</h2>
            <p class="count">5 links</p>
          </div>
          <div class="chips">
            {socials.map((s, i) => (
              <a
                class="chip reveal"
                style={`--d: ${240 + i * 45}ms`}
                href={s.href}
                {...(s.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {s.label}
                {s.external && <span class="arr" aria-hidden="true">↗</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="footer reveal" style="--d: 300ms">
      <div class="wrap">
        <p>© 2026 Abijith S · Kochi, IN</p>
        <p class="fine">Design /4 — Grid Marker</p>
      </div>
    </footer>

    <nav class="switcher" aria-label="Design switcher">
      <a href="/">/</a>
      <a href="/1">/1</a>
      <a href="/2">/2</a>
      <a href="/3">/3</a>
      <a href="/4" aria-current="page">/4</a>
      <a href="/5">/5</a>
    </nav>
  </body>
</html>

<style is:global>
  :root {
    --paper: oklch(98.5% 0 0);
    --ink: oklch(16% 0 0);
    --muted: oklch(45% 0 0);
    --accent: oklch(55% 0.21 262);
    --rule: oklch(16% 0 0 / 0.14);
    --ink-04: oklch(16% 0 0 / 0.04);
    --ink-30: oklch(16% 0 0 / 0.3);
    --font-sans: "Instrument Sans Variable", "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo,
      monospace;
  }

  html {
    background: var(--paper);
  }

  body {
    position: relative;
    margin: 0;
    border-top: 4px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--accent);
    color: var(--paper);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      transition-duration: 0.01ms;
    }
  }
</style>

<style>
  .wrap {
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }

  /* load reveals: scaffolding stays, content fades up into the grid */
  .reveal {
    animation: fade-up 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.55rem 0.9rem;
    text-decoration: none;
  }
  .skip:focus-visible {
    left: 0;
  }

  /* print registration marks */
  .mark {
    position: absolute;
    z-index: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--ink-30);
    pointer-events: none;
    user-select: none;
  }
  .m-tl {
    top: 0.6rem;
    left: 0.7rem;
  }
  .m-tr {
    top: 0.6rem;
    right: 0.7rem;
  }
  .m-bl {
    bottom: 0.6rem;
    left: 0.7rem;
  }
  .m-br {
    bottom: 0.6rem;
    right: 0.7rem;
  }

  /* masthead */
  .masthead {
    padding-block: 1.15rem;
  }
  .masthead .wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    flex-wrap: wrap;
  }
  .brand {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand a {
    color: inherit;
    text-decoration: none;
  }
  .brand a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
  }
  .masthead nav {
    display: flex;
    gap: 1.4rem;
  }
  .masthead nav a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .masthead nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
  }

  /* sections: full-width hairline rules, mono labels */
  .sec {
    border-top: 1px solid var(--rule);
    padding-block: 2.4rem 3rem;
  }
  .sechead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }
  .label {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .label .no {
    color: var(--accent);
  }
  .count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* 01 — index */
  h1 {
    margin: 0 0 1.5rem;
    max-width: 21ch;
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .dot {
    color: var(--accent);
  }
  .meta {
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lede {
    margin: 0;
    max-width: 56ch;
    font-size: 1.02rem;
    color: var(--muted);
  }

  /* 02 — projects: shared-border table grid */
  .pgrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ink);
    border: 1px solid var(--ink);
  }
  @media (min-width: 46rem) {
    .pgrid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    padding: 1.35rem 1.4rem 1.2rem;
    transition:
      transform 150ms ease-out,
      box-shadow 150ms ease-out;
  }
  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--accent);
    z-index: 1;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .card > p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .card-foot {
    margin-top: auto;
    padding-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .card:hover .card-foot span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cell-util {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    padding: 1.05rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 150ms ease-out;
  }
  .cell-util:hover {
    background: var(--ink-04);
  }
  .cell-util .arr {
    color: var(--muted);
    transition:
      transform 150ms ease-out,
      color 150ms ease-out;
  }
  .cell-util:hover .arr {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* 03 — writing: ruled table rows */
  .rows {
    border: 1px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: 6.4rem 1fr auto;
    gap: 1.1rem;
    align-items: baseline;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: background 150ms ease-out;
  }
  .row:last-child {
    border-bottom: none;
  }
  .row:hover {
    background: var(--ink-04);
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }
  .row h3 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .desc {
    margin: 0;
    max-width: 58ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .row .arr {
    font-family: var(--font-mono);
    transition:
      transform 150ms ease-out,
      color 150ms ease-out;
  }
  .row:hover .arr {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .allrow {
    grid-template-columns: 1fr auto;
  }
  .alllabel {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .allrow:hover .alllabel {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .allpath {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* 04 — elsewhere: invert-on-hover chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding: 0.55rem 0.85rem;
    text-decoration: none;
    transition:
      background 150ms ease-out,
      color 150ms ease-out;
  }
  .chip .arr {
    font-size: 0.85em;
  }
  .chip:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* footer */
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.4rem 3.6rem;
  }
  .footer .wrap {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    flex-wrap: wrap;
  }
  .footer p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer .fine {
    color: var(--muted);
  }

  /* design switcher */
  .switcher {
    position: fixed;
    right: 0.85rem;
    bottom: 0.85rem;
    z-index: 40;
    display: flex;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .switcher a {
    padding: 0.42rem 0.52rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    text-decoration: none;
    border-left: 1px solid var(--rule);
    transition:
      background 150ms ease-out,
      color 150ms ease-out;
  }
  .switcher a:first-child {
    border-left: none;
  }
  .switcher a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .switcher a[aria-current="page"] {
    background: var(--accent);
    color: var(--paper);
  }

  @media (max-width: 40rem) {
    .sec {
      padding-block: 2rem 2.4rem;
    }
    .card {
      padding: 1.15rem 1.1rem 1.05rem;
    }
    .row {
      grid-template-columns: auto 1fr auto;
      gap: 0.8rem;
      padding: 0.9rem 1rem;
    }
    .date {
      font-size: 0.68rem;
    }
    .switcher a {
      padding: 0.38rem 0.44rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
    .card:hover,
    .row:hover .arr,
    .cell-util:hover .arr {
      transform: none;
    }
  }
</style>
