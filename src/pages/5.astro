---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";

const socials = [
  { label: "github", href: "https://github.com/abijith-suresh", icon: "github" },
  { label: "x", href: "https://x.com/abijith_sh", icon: "x" },
  { label: "linkedin", href: "https://linkedin.com/in/abijith-suresh", icon: "linkedin" },
  { label: "bluesky", href: "https://bsky.app/profile/abijith.bsky.social", icon: "bluesky" },
  { label: "rss", href: "/rss.xml", icon: "rss" },
];

const projects = [
  {
    title: "Interleaf",
    description: "Client-side PDF manipulation tool - merge, split, reorder, rotate, and more",
    tags: ["TypeScript", "PDF", "Browser"],
    slug: "interleaf",
  },
  {
    title: "Microbreak",
    description: "Short, non-addictive puzzle games for build wait times.",
    tags: ["Games", "Puzzles", "Browser"],
    slug: "microbreak",
  },
  {
    title: "Prompts",
    description: "A collection of reusable AI agent prompts for coding agents and chat applications",
    tags: ["AI", "Prompts"],
    slug: "prompts",
  },
  {
    title: "Reshrimp",
    description: "Client-side image manipulation tool - resize, compress, convert formats in your browser",
    tags: ["TypeScript", "Image", "Browser"],
    slug: "reshrimp",
  },
  {
    title: "Skills",
    description: "My personal collection of AI skills",
    tags: ["AI", "Agent Skills"],
    slug: "skills",
  },
  {
    title: "Tailory",
    description:
      "Client-side resume editor — upload, edit, preview, and export your resume as PDF. No account, no server, all local.",
    tags: ["Astro", "Open Source"],
    slug: "tailory",
  },
];

const tagTints: Record<string, string> = {
  typescript: "t-sky",
  pdf: "t-violet",
  browser: "t-mint",
  games: "t-pink",
  puzzles: "t-sky",
  ai: "t-violet",
  prompts: "t-pink",
  image: "t-pink",
  "agent skills": "t-mint",
  astro: "t-violet",
  "open source": "t-mint",
};

const tintOf = (tag: string) => tagTints[tag.toLowerCase()] ?? "t-violet";
const designVariants = ["/", "/1", "/2", "/3", "/4", "/5"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abijith S — Design 5</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2b2535" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <div class="page">
      <header class="topbar rise" style="--d: 0ms">
        <a class="brand" href="/">abijith.sh</a>
        <nav class="topnav" aria-label="Primary">
          <a href="/writing/">/writing</a>
          <a href="/projects/">/projects</a>
          <a href="/about/">/about</a>
          <a href="/now/">/now</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <h1 class="rise" style="--d: 70ms">
            hi, i'm <span class="name-chip">abijith</span>.
          </h1>
          <p class="intro rise" style="--d: 140ms">
            Backend engineer at UST in Kochi, Kerala, India. I build with Java and
            Spring Boot — and outside work, I'm usually playing games or building
            something.
          </p>

          <ul class="socials rise" style="--d: 210ms">
            {
              socials.map((s) => (
                <li>
                  <a
                    class="social"
                    href={s.href}
                    {...(s.href.startsWith("http")
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {s.icon === "github" && (
                      <svg class="icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
                      </svg>
                    )}
                    {s.icon === "x" && (
                      <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.9 1.15h3.68l-8.04 9.19 9.46 12.51h-7.41l-5.8-7.58-6.63 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" />
                      </svg>
                    )}
                    {s.icon === "linkedin" && (
                      <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
                      </svg>
                    )}
                    {s.icon === "bluesky" && (
                      <svg class="icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 10.8c-1.09-2.11-4.05-6.05-6.8-8C2.57.94 1.56 1.27.9 1.57.14 1.91 0 3.08 0 3.77c0 .69.38 5.65.62 6.48.82 2.73 3.72 3.66 6.39 3.36.13-.02.27-.04.41-.06-.13.02-.27.04-.41.06-3.91.58-7.39 2-2.83 7.08 5.01 5.19 6.87-1.11 7.82-4.31.95 3.2 2.05 9.27 7.73 4.31 4.27-4.31 1.17-6.5-2.74-7.08a8.7 8.7 0 0 1-.41-.06c.14.02.28.04.41.06 2.67.3 5.57-.63 6.39-3.36.24-.83.62-5.79.62-6.48 0-.69-.14-1.86-.9-2.2-.66-.3-1.66-.63-4.3 1.24C16.05 4.75 13.09 8.69 12 10.8Z" />
                      </svg>
                    )}
                    {s.icon === "rss" && (
                      <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 11a9 9 0 0 1 9 9" />
                        <path d="M4 4a16 16 0 0 1 16 16" />
                        <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                    <span>{s.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section id="projects" class="section">
          <h2 class="section-title rise" style="--d: 280ms">projects</h2>
          <div class="grid">
            {
              projects.map((p, i) => (
                <a
                  class="card rise"
                  style={`--d: ${330 + i * 75}ms`}
                  href={`https://github.com/abijith-suresh/${p.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <h3>
                    {p.title} <span class="year">2026</span>
                  </h3>
                  <p>{p.description}</p>
                  <ul class="tags">
                    {p.tags.map((t) => (
                      <li class={`tag ${tintOf(t)}`}>{t}</li>
                    ))}
                  </ul>
                </a>
              ))
            }
          </div>
        </section>

        <section id="writing" class="section">
          <h2 class="section-title rise" style="--d: 400ms">writing</h2>
          <div class="rise" style="--d: 460ms">
            <a class="post" href="/writing/why-i-built-my-own-website/">
              <p class="post-date">2026-02-11</p>
              <h3 class="post-title">Why I Built My Own Website</h3>
              <p class="post-desc">
                On the value of owning your own corner of the internet, learning in
                public, and the satisfaction of building something for yourself.
              </p>
              <span class="read">
                read <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
            <a class="all-writing" href="/writing/">
              all writing <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </section>
      </main>

      <footer class="footer">
        <p>© 2026 abijith s</p>
        <p class="design-note">design 5 — violet night</p>
      </footer>
    </div>

    <nav class="switcher" aria-label="Design switcher">
      {
        designVariants.map((v) => (
          <a
            href={v}
            class={v === "/5" ? "active" : undefined}
            aria-current={v === "/5" ? "page" : undefined}
          >
            {v}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<style is:global>
  :root {
    --bg: oklch(21.7% 0.0215 293);
    --card: oklch(25.4% 0.03 293);
    --text: oklch(90.5% 0.0245 294);
    --muted: oklch(69.7% 0.028 300);
    --primary: oklch(70.6% 0.078 302);
    --pink: oklch(83.9% 0.069 3);
    --ink: oklch(23% 0.035 296);
    --hairline: oklch(100% 0 0 / 0.1);
    --ring: oklch(100% 0 0 / 0.08);
    --ring-hover: oklch(100% 0 0 / 0.15);
    --font-display: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
    --font-body: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }

  ::selection {
    background: oklch(70.6% 0.078 302 / 0.92);
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none;
      transition: none;
      transform: none;
      scroll-behavior: auto;
    }
  }
</style>

<style>
  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    min-height: 100svh;
  }

  a {
    color: inherit;
  }

  /* ---------- atmosphere ---------- */

  .glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 62% 46% at 50% 22%,
      oklch(70.6% 0.078 302 / 0.07),
      transparent 70%
    );
  }

  .page {
    position: relative;
    z-index: 1;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 2.5rem);
  }

  /* ---------- orchestrated load ---------- */

  .rise {
    animation: rise 560ms cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
    animation-delay: var(--d, 0ms);
  }

  /* ---------- nav ---------- */

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    padding-block: 1.75rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--primary);
  }

  .topnav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .topnav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 180ms ease;
  }

  .topnav a:hover {
    color: var(--text);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-top: clamp(4.5rem, 12vh, 7rem);
  }

  h1 {
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .name-chip {
    position: relative;
    display: inline-block;
    padding: 0.08em 0.3em 0.12em;
    margin-inline: -0.04em;
    color: var(--ink);
  }

  .name-chip::before {
    content: "";
    position: absolute;
    inset: -0.02em -0.03em;
    z-index: -1;
    border-radius: 1rem;
    background: linear-gradient(115deg, oklch(70.6% 0.078 302 / 0.7), oklch(83.9% 0.069 3 / 0.7));
    filter: blur(6px);
  }

  .intro {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  /* ---------- social chips ---------- */

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.07);
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .social .icon {
    transition: transform 180ms ease;
  }

  .social:hover {
    background: oklch(100% 0 0 / 0.12);
    color: var(--text);
  }

  .social:hover .icon {
    transform: translateX(2px);
  }

  /* ---------- sections ---------- */

  .section {
    margin-top: clamp(4rem, 10vh, 6.5rem);
  }

  .section-title {
    margin: 0 0 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    letter-spacing: -0.01em;
  }

  /* ---------- projects ---------- */

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    display: block;
    background: var(--card);
    border: 1px solid var(--ring);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--ring-hover);
    box-shadow: 0 10px 32px -8px oklch(70.6% 0.078 302 / 0.22);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.06rem;
    letter-spacing: -0.005em;
  }

  .year {
    margin-left: 0.35rem;
    color: var(--muted);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.78rem;
  }

  .card p {
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .t-violet {
    background: oklch(70.6% 0.078 302 / 0.16);
    color: oklch(86% 0.055 302);
  }

  .t-pink {
    background: oklch(83.9% 0.069 3 / 0.14);
    color: oklch(89% 0.045 3);
  }

  .t-sky {
    background: oklch(80% 0.07 240 / 0.14);
    color: oklch(87% 0.05 240);
  }

  .t-mint {
    background: oklch(84% 0.07 165 / 0.13);
    color: oklch(88% 0.055 165);
  }

  /* ---------- writing ---------- */

  .post {
    display: block;
    background: var(--card);
    border: 1px solid var(--ring);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .post:hover {
    transform: translateY(-2px);
    border-color: var(--ring-hover);
    box-shadow: 0 10px 32px -8px oklch(70.6% 0.078 302 / 0.22);
  }

  .post-date {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .post-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .post-desc {
    margin: 0 0 1.1rem;
    max-width: 52ch;
    color: var(--muted);
    font-size: 0.925rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--primary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .post:hover .arrow,
  .all-writing:hover .arrow {
    transform: translateX(3px);
  }

  .all-writing {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .all-writing:hover {
    color: var(--text);
  }

  /* ---------- footer ---------- */

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(4.5rem, 11vh, 7rem);
    padding-block: 1.75rem 4.5rem;
    border-top: 1px solid var(--hairline);
  }

  .footer p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .design-note {
    font-family: var(--font-display);
    font-weight: 500;
  }

  /* ---------- design switcher ---------- */

  .switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    display: flex;
    gap: 2px;
    padding: 3px;
    background: oklch(25.4% 0.03 293 / 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }

  .switcher a {
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease;
  }

  .switcher a:hover {
    background: oklch(100% 0 0 / 0.1);
    color: var(--text);
  }

  .switcher a.active {
    background: var(--primary);
    color: var(--ink);
    font-weight: 600;
  }
</style>
