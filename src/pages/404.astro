---
import Container from "@/components/ui/Container.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`404 - Page Not Found | ${SITE.title}`}
  description="The page you're looking for doesn't exist."
  noindex={true}
  jsonLd={{ type: "website" }}
>
  <div class="w-full mx-auto flex grow flex-col">
    <Container class="flex flex-col items-center justify-center gap-y-8 py-28">
      <div
        class="text-[8rem] font-medium select-none leading-none"
        style="color: var(--color-muted-foreground);"
        aria-hidden="true"
      >
        404
      </div>

      <div class="flex flex-col items-center gap-y-3 text-center">
        <h1 class="text-[clamp(1.875rem,4vw,3rem)] font-medium tracking-tight">Page Not Found</h1>
        <p class="text-lg max-w-md" style="color: var(--color-muted-foreground);">
          The page you're looking for doesn't exist or has been moved.
        </p>
      </div>

      <div class="pt-4">
        <a href="/" class="footer-link">← Back to Home</a>
      </div>
    </Container>
  </div>
</Layout>
