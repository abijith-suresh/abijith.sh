---
import Container from "@/components/ui/Container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  description="The page you're looking for doesn't exist."
  noindex={true}
  jsonLd={{ type: "website" }}
>
  <div class="page-404">
    <Container class="page-404-inner">
      <p class="eyebrow rise" style="--d: 0ms" aria-hidden="true">404</p>
      <h1 class="rise" style="--d: 60ms">page not found<span class="period">.</span></h1>
      <p class="page-404-note rise" style="--d: 120ms">
        the page you're looking for doesn't exist or has been moved.
      </p>
      <a class="back-link rise" style="--d: 180ms" href="/">
        <span class="arrow" aria-hidden="true">←</span> back to home
      </a>
    </Container>
  </div>
</Layout>

<style>
  .page-404 {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
  }

  .page-404-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
    row-gap: var(--space-2xs);
    padding-block: var(--page-block-start) var(--page-block-end);
  }

  .page-404-inner .eyebrow {
    color: var(--color-primary);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 650;
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--leading-heading);
  }

  .page-404-note {
    max-width: 32rem;
    margin-top: var(--space-2xs);
    color: var(--color-muted-foreground);
  }

  .back-link {
    margin-top: var(--space-s);
    display: inline-flex;
    align-items: center;
    gap: var(--gap-icon);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .back-link:hover .arrow {
    transform: translateX(-3px);
  }
</style>
