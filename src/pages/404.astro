---
import Container from "@/components/ui/Container.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`404 - Page Not Found | ${SITE.title}`}
  description="The page you're looking for doesn't exist."
  noindex={true}
  jsonLd={{ type: "website" }}
>
  <div class="page-404">
    <Container class="page-404-inner">
      <p class="eyebrow rise" style="--d: 0ms" aria-hidden="true">404</p>
      <h1 class="rise" style="--d: 60ms">page not found<span class="period">.</span></h1>
      <p class="page-404-note rise" style="--d: 120ms">
        the page you're looking for doesn't exist or has been moved.
      </p>
      <a class="back-link rise" style="--d: 180ms" href="/">
        <span class="arrow" aria-hidden="true">←</span> back to home
      </a>
    </Container>
  </div>
</Layout>

<style>
  .page-404 {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
  }

  .page-404-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
    row-gap: var(--space-2xs);
    padding-block: var(--page-block-start) var(--page-block-end);
  }

  .page-404-inner .eyebrow {
    color: var(--color-primary);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: var(--leading-heading);
  }

  .period {
    position: relative;
    display: inline-block;
    color: var(--color-pink);
  }

  /* the glow lives on a layered copy of the period so its intensity
     can breathe by animating opacity instead of repainting text-shadow */
  .period::after {
    content: ".";
    position: absolute;
    inset: 0;
    color: var(--color-pink);
    text-shadow:
      0 0 18px oklch(70.6% 0.078 302 / 0.6),
      0 0 36px oklch(83.9% 0.069 3 / 0.4);
    pointer-events: none;
    animation: glow-breathe 22s ease-in-out infinite alternate;
  }

  @keyframes glow-breathe {
    from {
      opacity: 0.75;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .period::after {
      animation: none;
    }
  }

  .page-404-note {
    max-width: 32rem;
    margin-top: var(--space-2xs);
    color: var(--color-muted-foreground);
  }

  .back-link {
    margin-top: var(--space-s);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .back-link:hover .arrow {
    transform: translateX(-3px);
  }
</style>
