---
import Container from "@/components/ui/Container.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`404 - Page Not Found | ${SITE.title}`}
  description="The page you're looking for doesn't exist."
  noindex={true}
  jsonLd={{ type: "website" }}
>
  <div style="width:100%;margin-inline:auto;display:flex;flex-grow:1;flex-direction:column">
    <Container class="page-404-container">
      <div
        style="font-size:8rem;font-weight:500;user-select:none;line-height:var(--leading-none);color:var(--color-muted-foreground)"
        aria-hidden="true"
      >
        404
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;row-gap:var(--spacing-3);text-align:center">
        <h1 style="font-size:clamp(1.875rem,4vw,3rem);font-weight:500;letter-spacing:-0.025em">Page Not Found</h1>
        <p style="font-size:var(--text-lg);max-width:28rem;color:var(--color-muted-foreground)">
          The page you're looking for doesn't exist or has been moved.
        </p>
      </div>

      <div style="padding-top:var(--spacing-4)">
        <a href="/" class="footer-link">← Back to Home</a>
      </div>
    </Container>
  </div>
</Layout>
<style>
  .page-404-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    row-gap: var(--spacing-8);
    padding-block: 7rem;
  }
</style>
