---
import Container from "@/components/ui/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { riseStep } from "@/lib/motion";
---

<Layout
  description="the page you're looking for doesn't exist."
  noindex={true}
  jsonLd={{ type: "website" }}
>
  <div class="page-404">
    <Container class="page-404-inner">
      <h1 class="page-title rise" style={`--d: ${riseStep(0)}`}>page not found<span class="period">.</span></h1>
      <p class="page-404-note rise" style={`--d: ${riseStep(1)}`}>
        the page you're looking for doesn't exist or has been moved.
      </p>
      <a class="all-link back-link rise" style={`--d: ${riseStep(2)}`} href="/">
        <span class="arrow" aria-hidden="true">←</span> back to home
      </a>
    </Container>
  </div>
</Layout>

<style>
  .page-404 {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
  }

  .page-404-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-2xs);
    /* symmetric so the centered stack doesn't lean; doubles as
       breathing room on viewports too small to center into */
    padding-block: var(--space-2xl);
  }

  h1 {
    --title-size: var(--text-hero);
  }

  .page-404-note {
    max-width: 32rem;
    margin-block-start: var(--space-2xs);
    color: var(--color-muted-foreground);
  }

  .back-link {
    --arrow-shift: -3px;
    margin-block-start: var(--space-s);
    font-weight: 500;
  }
</style>
