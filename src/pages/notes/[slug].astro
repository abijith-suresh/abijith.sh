---
import ContentDetailPage from "@/components/ContentDetailPage.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { extractExcerpt } from "@/lib/extract-excerpt";
import { formatDate } from "@/lib/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { date } = note.data;
const { Content } = await render(note);
const formattedDate = formatDate(date);
const excerpt = extractExcerpt(note.body ?? "") ?? `A note from ${formattedDate}`;
---

<Layout
  title={`${formattedDate} - Notes - ${SITE.title}`}
  description={excerpt}
  type="article"
  article={{
    publishedTime: date,
    authors: [SITE.author],
  }}
  jsonLd={{
    type: "article",
    article: {
      headline: formattedDate,
      description: excerpt,
      datePublished: date,
    },
  }}
>
  <ContentDetailPage
    title={formattedDate}
    meta={[{ type: "date", value: formattedDate, datetime: date.toISOString() }]}
    microformat="h-entry"
  >
    {note.data.tags.map((tag) => <data class="p-category sr-only" value={tag}>{tag}</data>)}
    <a class="u-url sr-only" href={Astro.url.pathname}>Permalink</a>
    <Content />
  </ContentDetailPage>
</Layout>
