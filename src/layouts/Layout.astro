---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { SEOProps } from "@/components/seo/SEO.astro";
import type { JsonLdProps } from "@/components/seo/JsonLd.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/consts";
import baseCss from "@/styles/base.css?raw";
import tokensCss from "@/styles/tokens.css?raw";
import "@/styles/global.css";

const criticalCss = `${tokensCss}\n${baseCss}`;

interface Props extends SEOProps {
  title?: string;
  description?: string;
  jsonLd?: JsonLdProps;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalURL,
  noindex,
  article,
  type,
  jsonLd,
} = Astro.props as Props;

const resolvedJsonLd = jsonLd ?? {
  type: type === "profile" ? "person" : "website",
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <style is:inline set:html={criticalCss}></style>

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalURL={canonicalURL}
      noindex={noindex}
      article={article}
      type={type}
    />

    <!-- Structured Data -->
    <JsonLd {...resolvedJsonLd} />

    <slot name="head" />
  </head>
  <body style="display:flex;height:fit-content;min-height:100vh;flex-direction:column">
    <a
      href="#main-content"
      class="skip-link"
    >
      skip to content
    </a>
    <header class="site-topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">abijith.sh</a>
        <nav class="topnav" aria-label="Primary">
          {[
            { href: "/writing/", label: "writing" },
            { href: "/projects/", label: "projects" },
            { href: "/about/", label: "about" },
            { href: "/now/", label: "now" },
          ].map((item) => {
            const current = Astro.url.pathname.replace(/\/$/, "") || "/";
            const active =
              current === item.href.replace(/\/$/, "") ||
              current.startsWith(`${item.href.replace(/\/$/, "")}/`);
            return (
              <a href={item.href} aria-current={active ? "page" : undefined}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>
    <main id="main-content" style="width:100%;margin-inline:auto;display:flex;flex-grow:1;flex-direction:column">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="topbar-inner footer-inner">
        <p>&copy; 2026 abijith suresh</p>
        <nav class="footer-socials" aria-label="Social">
          {
            SITE.socialLinks.map((social) => (
              <a
                href={social.href}
                {...(social.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {social.label.toLowerCase()}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
  </body>
</html>
<style>
  .site-topbar,
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
  }

  .topbar-inner {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: var(--page-inline);
  }

  .site-topbar {
    display: flex;
    align-items: center;
    padding-block: 1.5rem 0.25rem;
  }

  .site-topbar .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    width: 100%;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .brand:hover {
    color: var(--color-text);
  }

  .topnav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
  }

  .topnav a {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .topnav a:hover,
  .topnav a[aria-current="page"] {
    color: var(--color-text);
  }

  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    padding-block: 1.5rem 3rem;
  }

  .footer-inner p {
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
  }

  .footer-socials a {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .footer-socials a:hover {
    color: var(--color-text);
  }

  .skip-link {
    position: absolute;
    width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0;
  }
  .skip-link:focus {
    position: fixed; top: var(--spacing-4); left: var(--spacing-4); z-index: var(--z-skip-link);
    width: auto; height: auto; padding: var(--spacing-4) var(--spacing-2); margin: 0;
    overflow: visible; clip: auto; white-space: normal;
    background-color: oklch(100% 0 0); color: var(--color-ink); font-weight: 500;
  }

  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
