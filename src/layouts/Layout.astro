---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import Container from "@/components/ui/Container.astro";
import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { SEOProps } from "@/components/seo/SEO.astro";
import type { JsonLdProps } from "@/components/seo/JsonLd.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/consts";
import baseCss from "@/styles/base.css?raw";
import tokensCss from "@/styles/tokens.css?raw";
import fontsCss from "@/styles/fonts.css?raw";
import geistFontUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import bricolageFontUrl from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "@/styles/global.css";

/* Latin faces of the variable families for first paint. The descriptors
   mirror the fontsource declarations so both copies resolve to the same
   hashed binary — inlining lets font fetches start during the first
   stylesheet pass instead of after the main stylesheet resolves. */
const variableFontFaces = `
/* geist-latin-wght */
@font-face {
  font-family: "Geist Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url("${geistFontUrl}") format("woff2-variations");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}

/* bricolage-grotesque-latin-wght */
@font-face {
  font-family: "Bricolage Grotesque Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url("${bricolageFontUrl}") format("woff2-variations");
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
`;

const criticalCss = [tokensCss, baseCss, fontsCss, variableFontFaces].join("\n");

interface Props extends SEOProps {
  title?: string;
  description?: string;
  jsonLd?: JsonLdProps;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalURL,
  noindex,
  article,
  type,
  jsonLd,
} = Astro.props as Props;

const resolvedJsonLd = jsonLd ?? {
  type: type === "profile" ? "person" : "website",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    <meta name="color-scheme" content="dark" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- First-paint fonts: binaries race the main stylesheet instead of
         waiting for it. Fonts always fetch with CORS, so preloads need
         crossorigin even for same-origin files. -->
    <link rel="preload" as="font" type="font/woff2" href={geistFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bricolageFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/IBMPlexMono-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/IBMPlexMono-Medium.woff2" crossorigin />

    <style is:inline set:html={criticalCss}></style>

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalURL={canonicalURL}
      noindex={noindex}
      article={article}
      type={type}
    />

    <!-- Structured Data -->
    <JsonLd {...resolvedJsonLd} />

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="skip-link sr-only"
    >
      skip to content
    </a>
    <header class="site-topbar">
      <Container class="topbar-inner">
        <a class="brand quiet-link" href="/">abijith.sh</a>
        <nav class="topnav" aria-label="Primary">
          {[
            { href: "/writing/", label: "writing" },
            { href: "/projects/", label: "projects" },
            { href: "/about/", label: "about" },
            { href: "/now/", label: "now" },
          ].map((item) => {
            const current = Astro.url.pathname.replace(/\/$/, "") || "/";
            const active =
              current === item.href.replace(/\/$/, "") ||
              current.startsWith(`${item.href.replace(/\/$/, "")}/`);
            return (
              <a class="quiet-link" href={item.href} aria-current={active ? "page" : undefined}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </Container>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="topbar-inner footer-inner">
        <p>&copy; 2026 abijith suresh</p>
        <nav class="footer-socials" aria-label="Social">
          {
            SITE.socialLinks.map((social) => (
              <a
                class="quiet-link"
                href={social.href}
                {...(social.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {social.label.toLowerCase()}
              </a>
            ))
          }
        </nav>
      </Container>
    </footer>
    <script>
      document.addEventListener("astro:after-swap", () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const elements = document.querySelectorAll<HTMLElement>(".rise");
        if (elements.length === 0) return;
        for (const element of elements) element.style.animation = "none";
        // Commit all resets together, then restart the existing CSS choreography.
        void document.body.offsetHeight;
        for (const element of elements) element.style.removeProperty("animation");
      });
    </script>
  </body>
</html>
<style>
  .site-topbar,
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    inline-size: 100%;
  }

  .site-topbar {
    display: flex;
    align-items: center;
    padding-block: 1.5rem 0.25rem;
  }

  .site-topbar .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--letter-spacing-tight);
  }

  .topnav,
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    font-size: var(--text-sm);
  }

  .site-footer {
    margin-block-start: auto;
    border-block-start: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    padding-block: 1.5rem 3rem;
  }

  .footer-inner p {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }

  .skip-link:focus {
    position: fixed;
    inset-block-start: var(--space-s);
    inset-inline-start: var(--space-s);
    z-index: var(--z-skip-link);
    inline-size: auto;
    block-size: auto;
    padding: var(--space-s) var(--space-2xs);
    margin: 0;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    background-color: var(--color-white);
    color: var(--color-ink);
    font-weight: 500;
  }

  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
