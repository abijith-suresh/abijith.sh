---
import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { SEOProps } from "@/components/seo/SEO.astro";
import type { JsonLdProps } from "@/components/seo/JsonLd.astro";
import "@/styles/global.css";

interface Props extends SEOProps {
  title?: string;
  description?: string;
  jsonLd?: JsonLdProps;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalURL,
  noindex,
  article,
  type,
  jsonLd,
} = Astro.props as Props;

const resolvedJsonLd = jsonLd ?? {
  type: type === "profile" ? "person" : "website",
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalURL={canonicalURL}
      noindex={noindex}
      article={article}
      type={type}
    />

    <!-- Structured Data -->
    <JsonLd {...resolvedJsonLd} />

    <slot name="head" />
  </head>
  <body style="display:flex;height:fit-content;min-height:100vh;flex-direction:column">
    <a
      href="#main-content"
      class="skip-link"
    >
      Skip to content
    </a>
    <main id="main-content" style="width:100%;margin-inline:auto;display:flex;flex-grow:1;flex-direction:column">
      <slot />
    </main>
  </body>
</html>
<style>
  .skip-link {
    position: absolute;
    width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0;
  }
  .skip-link:focus {
    position: fixed; top: var(--spacing-4); left: var(--spacing-4); z-index: 50;
    width: auto; height: auto; padding: var(--spacing-4) var(--spacing-2); margin: 0;
    overflow: visible; clip: auto; white-space: normal;
    background-color: var(--color-text); color: var(--color-bg); font-weight: 500;
  }
</style>
