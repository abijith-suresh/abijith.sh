---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import Container from "@/components/ui/Container.astro";
import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { SEOProps } from "@/components/seo/SEO.astro";
import type { JsonLdProps } from "@/components/seo/JsonLd.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/consts";
import baseCss from "@/styles/base.css?raw";
import tokensCss from "@/styles/tokens.css?raw";
import "@/styles/global.css";

const criticalCss = `${tokensCss}\n${baseCss}`;

interface Props extends SEOProps {
  title?: string;
  description?: string;
  jsonLd?: JsonLdProps;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalURL,
  noindex,
  article,
  type,
  jsonLd,
} = Astro.props as Props;

const resolvedJsonLd = jsonLd ?? {
  type: type === "profile" ? "person" : "website",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    <meta name="color-scheme" content="dark" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <style is:inline set:html={criticalCss}></style>

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalURL={canonicalURL}
      noindex={noindex}
      article={article}
      type={type}
    />

    <!-- Structured Data -->
    <JsonLd {...resolvedJsonLd} />

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="skip-link sr-only"
    >
      skip to content
    </a>
    <header class="site-topbar">
      <Container class="topbar-inner">
        <a class="brand quiet-link" href="/">abijith.sh</a>
        <nav class="topnav" aria-label="Primary">
          {[
            { href: "/writing/", label: "writing" },
            { href: "/projects/", label: "projects" },
            { href: "/about/", label: "about" },
            { href: "/now/", label: "now" },
          ].map((item) => {
            const current = Astro.url.pathname.replace(/\/$/, "") || "/";
            const active =
              current === item.href.replace(/\/$/, "") ||
              current.startsWith(`${item.href.replace(/\/$/, "")}/`);
            return (
              <a class="quiet-link" href={item.href} aria-current={active ? "page" : undefined}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </Container>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="topbar-inner footer-inner">
        <p>&copy; 2026 abijith suresh</p>
        <nav class="footer-socials" aria-label="Social">
          {
            SITE.socialLinks.map((social) => (
              <a
                class="quiet-link"
                href={social.href}
                {...(social.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {social.label.toLowerCase()}
              </a>
            ))
          }
        </nav>
      </Container>
    </footer>
    <script>
      document.addEventListener("astro:after-swap", () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const elements = document.querySelectorAll<HTMLElement>(".rise");
        if (elements.length === 0) return;
        for (const element of elements) element.style.animation = "none";
        // Commit all resets together, then restart the existing CSS choreography.
        void document.body.offsetHeight;
        for (const element of elements) element.style.removeProperty("animation");
      });
    </script>
  </body>
</html>
<style>
  .site-topbar,
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    inline-size: 100%;
  }

  .site-topbar {
    display: flex;
    align-items: center;
    padding-block: 1.5rem 0.25rem;
  }

  .site-topbar .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--letter-spacing-tight);
  }

  .topnav,
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    font-size: var(--text-sm);
  }

  .site-footer {
    margin-block-start: auto;
    border-block-start: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    padding-block: 1.5rem 3rem;
  }

  .footer-inner p {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }

  .skip-link:focus {
    position: fixed;
    inset-block-start: var(--space-s);
    inset-inline-start: var(--space-s);
    z-index: var(--z-skip-link);
    inline-size: auto;
    block-size: auto;
    padding: var(--space-s) var(--space-2xs);
    margin: 0;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    background-color: var(--color-white);
    color: var(--color-ink);
    font-weight: 500;
  }

  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
