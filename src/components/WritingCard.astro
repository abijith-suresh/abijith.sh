---
import ContentCard from "@/components/ContentCard.astro";
import { getWritingUrl } from "@/lib/routes";
import { calculateReadingTime, formatDate, formatReadingTime } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writing">;
  class?: string;
}

const { post, class: className } = Astro.props;
const { title, description, publishedDate } = post.data;
const postUrl = getWritingUrl(post.id);
const formattedDate = formatDate(publishedDate);
const readingTime = calculateReadingTime(post.body ?? "");
const meta = `${formattedDate} · ${formatReadingTime(readingTime)}`;
---

<ContentCard
  title={title}
  description={description}
  href={postUrl}
  meta={meta}
  class:list={className}
/>
