---
import Link from "@/components/Link.astro";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  description: string;
  href: string;
  meta?: string;
  class?: string;
}

const { title, description, href, meta, class: className } = Astro.props;
---

<article class:list={cn("group card-hover", className)}>
  <Link href={href} class="block p-4" prefetch="hover">
    <div class="flex flex-col gap-3">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg font-medium leading-snug">
          {title}
        </h3>
      </div>
      {meta && <p class="eyebrow">{meta}</p>}
      <p
        class="text-sm leading-[calc(0.65rem+1em)] line-clamp-2"
        style="color: var(--color-muted-foreground);"
      >
        {description}
      </p>
    </div>
  </Link>
</article>
