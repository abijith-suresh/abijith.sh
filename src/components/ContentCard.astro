---
interface Props {
  title: string;
  description: string;
  href: string;
  meta?: string;
  class?: string;
}

const { title, description, href, meta, class: className } = Astro.props;
---

<a
  href={href}
  class:list={["ledger-row", className]}
  data-astro-prefetch="hover"
>
  <span class="ledger-title">{title}</span>
  {meta && <span class="ledger-meta">{meta}</span>}
  <span class="ledger-desc">{description}</span>
</a>

<style>
  .ledger-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: var(--space-s);
    padding-block: var(--space-xs);
    border-bottom: var(--border-width) solid var(--color-border);
    text-decoration: none;
    transition: background-color var(--transition-base);
    margin-inline: calc(-1 * var(--page-inline));
    padding-inline: var(--page-inline);
  }
  @media (hover: hover) and (pointer: fine) {
    .ledger-row:hover {
      background-color: var(--color-surface-strong);
    }
  }
  .ledger-title {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    line-height: var(--leading-text);
  }
  .ledger-meta {
    font-size: var(--text-xs);
    color: var(--color-muted-foreground);
    line-height: var(--leading-none);
    white-space: nowrap;
  }
  .ledger-desc {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
    line-height: var(--leading-text);
    margin-top: var(--space-3xs);
  }
</style>
