---
import Link from "@/components/Link.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  meta?: string;
  class?: string;
}

const { title, description, href, meta, class: className } = Astro.props;
---

<article class:list={["group card-hover", className]}>
  <Link href={href} style="display:block;padding:var(--spacing-4)" prefetch="hover">
    <div style="display:flex;flex-direction:column;gap:var(--spacing-3)">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--spacing-3)">
        <h3 style="font-size:var(--text-lg);font-weight:500;line-height:1.375">
          {title}
        </h3>
      </div>
      {meta && <p class="eyebrow">{meta}</p>}
      <p
        style="font-size:var(--text-sm);line-height:calc(0.65rem+1em);overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:var(--color-muted-foreground)"
      >
        {description}
      </p>
    </div>
  </Link>
</article>
