---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  href: string;
  /** External links open in a new tab */
  external?: boolean;
  /** Optimized local image (src/assets/...) */
  image?: ImageMetadata;
  /** Remote/absolute fallback image URL when no local image exists */
  imageSrc?: string;
  /** Display initial shown when no image is available */
  placeholder?: string;
  /** Solid media-panel background (project brand color, hex from frontmatter) */
  accent?: string;
}

const { title, description, href, external = false, image, imageSrc, placeholder, accent } =
  Astro.props;
---

<a
  class:list={["media-card"]}
  href={href}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span
    class="media-card-media"
    aria-hidden="true"
    style={accent ? `--panel-accent: ${accent}` : undefined}
  >
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={[640, 1280]}
          sizes="(min-width: 40rem) 26rem, 100vw"
          loading="lazy"
          decoding="async"
          class="media-card-img"
        />
      ) : imageSrc ? (
        <img
          src={imageSrc}
          alt=""
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          class="media-card-img"
        />
      ) : (
        <span class="media-card-ph">{placeholder}</span>
      )
    }
  </span>
  <span class="media-card-body">
    <span class="media-card-title">{title}</span>
    <span class="media-card-desc">{description}</span>
  </span>
</a>
