---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  href: string;
  /** External links open in a new tab */
  external?: boolean;
  /** Flip the media panel to the right and mirror its screenshot framing */
  flip?: boolean;
  /** Optimized local image (src/assets/...) */
  image?: ImageMetadata;
  /** Remote/absolute fallback image URL when no local image exists */
  imageSrc?: string;
  /** Display initial shown when no image is available */
  placeholder?: string;
  /** Solid media-panel background (project brand color, hex from frontmatter) */
  accent?: string;
}

const {
  title,
  description,
  href,
  external = false,
  flip = false,
  image,
  imageSrc,
  placeholder,
  accent,
} = Astro.props;
---

<a
  class:list={["media-card", { "media-card--flip": flip }]}
  href={href}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span
    class="media-card-media"
    aria-hidden="true"
    style={accent ? `--panel-accent: ${accent}` : undefined}
  >
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={[640, 1280]}
          sizes="(min-width: 40rem) 26rem, 100vw"
          loading="lazy"
          decoding="async"
          class="media-card-img"
        />
      ) : imageSrc ? (
        <img
          src={imageSrc}
          alt=""
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          class="media-card-img"
        />
      ) : (
        <span class="media-card-ph">{placeholder}</span>
      )
    }
  </span>
  <span class="media-card-body">
    <span class="media-card-title">{title}</span>
    <span class="media-card-desc">{description}</span>
  </span>
</a>

<style>
  /* ── Media card — horizontal, solid accent panel one side,
        title + description the other, alternating left/right.
        The one card pattern for projects and writing. ────────────── */
  .media-card {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    background: var(--color-card);
    border: 1px solid var(--ring);
    border-radius: var(--radius-card);
    overflow: clip;
    text-decoration: none;
    transition:
      transform var(--transition-lift),
      border-color var(--transition-lift);
  }

  .media-card--flip {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }

  .media-card-media {
    position: relative;
    display: block;
    min-height: 11rem;
    height: 100%;
    overflow: clip;
    /* solid per-project accent when provided, neutral card tone otherwise */
    background: var(--panel-accent, var(--color-card));
  }

  .media-card--flip .media-card-media {
    order: 2;
  }

  /* the screenshot floats offset toward the top-left and bleeds off the
     bottom-right — its overflowing edges are cut by the panel */
  .media-card-img {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 100%;
    height: 100%;
    max-inline-size: none;
    object-fit: cover;
    object-position: top left;
    border-radius: 0.75rem 0 0 0;
    outline: 1px solid var(--color-border);
    outline-offset: -1px;
    transition: filter var(--transition-lift);
  }

  /* mirror the screenshot framing when the media panel moves to the right */
  .media-card--flip .media-card-img {
    right: 1rem;
    left: auto;
    object-position: top right;
    border-radius: 0 0.75rem 0 0;
  }

  /* hover effects are desktop-only: gate them behind hover-capable pointers so
     touch devices don't get sticky hover lifts mid-scroll */
  @media (hover: hover) and (pointer: fine) {
    .media-card:hover {
      border-color: var(--ring-hover);
    }

    .media-card:hover .media-card-img {
      filter: brightness(1.06);
    }

    @media (prefers-reduced-motion: no-preference) {
      .media-card:hover {
        transform: translateY(-2px);
      }
    }
  }

  .media-card-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 4rem;
    letter-spacing: var(--letter-spacing-display);
    color: oklch(from var(--color-white) l c h / 0.85);
  }

  .media-card:active {
    border-color: var(--ring-hover);
  }

  .media-card-body {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  .media-card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .media-card-desc {
    margin-block-start: 0.5rem;
    color: var(--color-muted-foreground);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  @media (max-width: 40rem) {
    .media-card,
    .media-card--flip {
      grid-template-columns: 1fr;
    }

    /* both card variants stack image-first on mobile — this (0,2,0) rule sits
       after the flip rule above, so it wins the cascade for flip cards too */
    .media-card .media-card-media {
      order: -1;
      min-height: 0;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .media-card-ph {
      position: absolute;
      inset: 0;
    }
  }
</style>
