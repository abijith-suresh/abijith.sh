---
import { SITE } from "@/consts";
import { getOgImagePath, getRouteMetadata, normalizePagePath } from "@/lib/route-metadata";

export interface SEOProps {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  noindex?: boolean;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    authors?: string[];
  };
  type?: "website" | "article" | "profile";
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalURL,
  noindex = false,
  article,
  type,
} = Astro.props;

const routeMetadata = getRouteMetadata(Astro.url.pathname);
const resolvedTitle = title ?? routeMetadata?.title ?? SITE.title;
const resolvedDescription = description ?? routeMetadata?.description ?? SITE.description;
const resolvedType = type ?? routeMetadata?.type ?? "website";
const resolvedImageAlt = imageAlt ?? `${resolvedTitle} - ${resolvedDescription}`;
const resolvedCanonicalURL =
  canonicalURL ?? new URL(normalizePagePath(Astro.url.pathname), Astro.site).href;

const ogType = article ? "article" : resolvedType;
const ogImagePath = image ?? getOgImagePath(Astro.url.pathname);

const ogImage = new URL(ogImagePath, Astro.site).href;
---

<title>{resolvedTitle}</title>

<!-- Primary Meta Tags -->
<meta name="title" content={resolvedTitle} />
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={resolvedCanonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonicalURL} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />

{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      {article.authors?.map((author: string) => (
        <meta property="article:author" content={author} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonicalURL} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />
<meta name="twitter:creator" content={SITE.twitterHandle} />
<meta name="twitter:site" content={SITE.twitterHandle} />
