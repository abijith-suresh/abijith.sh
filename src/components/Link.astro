---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
  style?: string;
  underline?: boolean;
  prefetch?: boolean | "hover" | "tap" | "load" | "viewport";
  [key: string]: unknown;
}

const { href, external, class: className, style, underline, prefetch, ...rest } = Astro.props;
const isExternal = external;
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  data-astro-prefetch={!isExternal && prefetch ? prefetch : undefined}
  class:list={[underline && "link-underline", className]}
  style={style}
  {...rest}
>
  <slot />
</a>

<style>
  .link-underline {
    text-decoration: none;
  }
  .link-underline:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-foreground);
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
</style>
