---
import { cn } from "@/lib/utils";

interface Props {
  href: string;
  external?: boolean;
  class?: string;
  style?: string;
  underline?: boolean;
  prefetch?: boolean | "hover" | "tap" | "load" | "viewport";
  [key: string]: unknown;
}

const { href, external, class: className, style, underline, prefetch, ...rest } = Astro.props;
const isExternal = external;
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  data-astro-prefetch={!isExternal && prefetch ? prefetch : undefined}
  class:list={cn(
    underline &&
      "no-underline hover:underline hover:decoration-foreground hover:underline-offset-2 hover:decoration-1",
    className
  )}
  style={style}
  {...rest}
>
  <slot />
</a>
