---
interface Props {
  /** Page title */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-y-3", className]}>
  <h1 class="text-[clamp(1.875rem,4vw,3rem)] font-medium tracking-tight">{title}</h1>
  {subtitle && <p style="color: var(--color-muted-foreground);">{subtitle}</p>}
</div>
