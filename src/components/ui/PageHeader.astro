---
interface Props {
  /** Page title — page chrome renders in the site's lowercase voice */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class:list={["page-header", "rise", className]} style="--d: 0ms">
  <h1>{title.toLowerCase()}<span class="period">.</span></h1>
  {subtitle && <p>{subtitle}</p>}
</div>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    row-gap: var(--title-subtitle-gap);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--text-page);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--leading-heading);
  }

  .page-header p {
    color: var(--color-muted-foreground);
  }
</style>
