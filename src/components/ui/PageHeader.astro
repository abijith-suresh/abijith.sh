---
interface Props {
  /** Page title */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div style="display:flex; flex-direction:column; row-gap:var(--spacing-3)" class={className}>
  <h1 style="font-size:clamp(1.875rem,4vw,3rem); font-weight:500; letter-spacing:-0.025em">{title}</h1>
  {subtitle && <p style="color:var(--color-muted-foreground)">{subtitle}</p>}
</div>
