---
import { riseStep } from "@/lib/motion";

interface Props {
  /** Page title — page chrome renders in the site's lowercase voice */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class:list={["page-header", "rise", className]} style={`--d: ${riseStep(0)}`}>
  <h1 class="page-title">{title.toLowerCase()}<span class="period">.</span></h1>
  {subtitle && <p>{subtitle}</p>}
</div>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    row-gap: var(--title-subtitle-gap);
  }

  .page-header p {
    color: var(--color-muted-foreground);
  }
</style>
