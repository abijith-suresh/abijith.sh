---
interface Props {
  /** Page title */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div style="display:flex; flex-direction:column; row-gap:var(--title-subtitle-gap)" class={className}>
  <h1 style="font-size:var(--heading-1); letter-spacing:0; line-height:var(--leading-heading)">{title}</h1>
  {subtitle && <p style="color:var(--color-muted-foreground)">{subtitle}</p>}
</div>
