---
interface Props {
  /** The empty-state message to display */
  message: string;
  class?: string;
}

const { message, class: className } = Astro.props;
---

<div class:list={["empty-state", className]}>
  <div class="empty-state-mark" aria-hidden="true">—</div>
  <div class="empty-state-rule" aria-hidden="true"></div>
  <p class="eyebrow">{message}</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    padding-block: 5rem;
  }

  .empty-state-mark {
    font-size: 5rem;
    font-weight: 500;
    line-height: var(--leading-none);
    user-select: none;
    font-variant-numeric: tabular-nums;
    color: var(--color-border);
  }

  .empty-state-rule {
    inline-size: var(--space-l);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .eyebrow {
    text-align: center;
  }
</style>
