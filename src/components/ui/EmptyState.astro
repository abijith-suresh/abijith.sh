---
interface Props {
  /** The empty-state message to display */
  message: string;
  class?: string;
}

const { message, class: className } = Astro.props;
---

<div
  style="display:flex; flex-direction:column; align-items:center; gap:var(--spacing-4); padding-block:5rem"
  class={className}
>
  <div
    style="font-size:5rem; font-weight:500; line-height:var(--leading-none); user-select:none; font-variant-numeric:tabular-nums; color:var(--color-border)"
    aria-hidden="true"
  >
    —
  </div>
  <div style="width:var(--spacing-8); border-top:var(--border-width) solid var(--color-border); border-color:var(--color-border)"></div>
  <p class="eyebrow" style="text-align:center; color:var(--color-muted-foreground)">{message}</p>
</div>
