---
import Container from "@/components/ui/Container.astro";
import PageHeader from "@/components/ui/PageHeader.astro";

interface Props {
  /** Page title */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class for the outer wrapper */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class:list={["page-shell", className]}>
  <div class="page-shell-header">
    <Container>
      <PageHeader title={title} subtitle={subtitle} />
    </Container>
  </div>
  <slot />
</div>

<style>
  .page-shell {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    padding-bottom: var(--page-block-end);
  }

  /* air between the page header and the first section — mirrors the
     homepage hero-to-section rhythm */
  .page-shell-header {
    padding-top: var(--page-block-start);
    padding-bottom: clamp(4rem, 10vh, 6.5rem);
  }
</style>
