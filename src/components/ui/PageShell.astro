---
import Container from "@/components/ui/Container.astro";
import PageHeader from "@/components/ui/PageHeader.astro";

interface Props {
  /** Page title */
  title: string;
  /** Subtitle / description below the title */
  subtitle?: string;
  /** Additional CSS class for the outer wrapper */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div style="width:100%; margin-inline:auto; display:flex; flex-grow:1; flex-direction:column; row-gap:var(--spacing-12); padding-bottom:var(--spacing-16)" class={className}>
  <Container style="padding-top:var(--spacing-8); display:flex; flex-direction:column; row-gap:var(--spacing-8)">
    <PageHeader title={title} subtitle={subtitle} />
  </Container>

  <slot />
</div>
