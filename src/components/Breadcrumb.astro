---
import Link from "@/components/Link.astro";
import { Icon } from "astro-icon/components";
import type { BreadcrumbItem } from "@/lib/types";

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["flex items-center gap-2 eyebrow", className]}>
  {
    items.map((item, index) => {
      const isLast = index === items.length - 1;
      const inner = (
        <>
          {item.icon && <Icon name={item.icon} class="w-3 h-3" />}
          {item.label}
        </>
      );

      return (
        <>
          {item.href ? (
            <Link
              href={item.href}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-[var(--color-text)]"
              style="color: var(--color-muted);"
            >
              {inner}
            </Link>
          ) : (
            <span
              class="inline-flex items-center gap-1.5 truncate"
              style="color: var(--color-text);"
              aria-current="page"
            >
              {inner}
            </span>
          )}
          {!isLast && <span style="color: var(--color-muted); opacity: 0.4;">/</span>}
        </>
      );
    })
  }
</nav>
