---
import ContentCard from "@/components/ContentCard.astro";
import { extractExcerpt } from "@/lib/extract-excerpt";
import { getNoteUrl } from "@/lib/routes";
import { formatDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  note: CollectionEntry<"notes">;
  class?: string;
}

const { note, class: className } = Astro.props;
const { date } = note.data;
const noteUrl = getNoteUrl(note.id);
const formattedDate = formatDate(date);
const excerpt = extractExcerpt(note.body ?? "");
---

<article class:list={["h-entry", className]}>
  <ContentCard
    title={formattedDate}
    description={excerpt ?? ""}
    href={noteUrl}
    class="u-url"
  />
  <time class="dt-published sr-only" datetime={date.toISOString()}>{formattedDate}</time>
  {note.data.tags.map((tag) => <data class="p-category sr-only" value={tag}>{tag}</data>)}
</article>
