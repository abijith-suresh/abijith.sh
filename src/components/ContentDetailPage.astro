---
interface MetaItem {
  type: "date" | "text";
  value: string;
  datetime?: string;
}

interface Props {
  /** Page title */
  title: string;
  /** Description paragraph */
  description?: string;
  /** Meta items (date, reading time, etc.) */
  meta?: MetaItem[];
  class?: string;
}

const { title, description, meta, class: className } = Astro.props;
---

<section class:list={["mx-auto w-full max-w-[640px] px-6 flex flex-col gap-y-8 pb-16", className]}>
  <!-- Header -->
  <header class="flex flex-col gap-y-5 pt-4">
    <h1 class="text-[clamp(2rem,4.5vw,3.5rem)] font-medium tracking-tight leading-tight">
      {title}
    </h1>

    {
      meta && meta.length > 0 && (
        <div
          class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
          style="color: var(--color-muted-foreground);"
        >
          {meta.map((item, index) => (
            <>
              {item.type === "date" ? (
                <time datetime={item.datetime}>{item.value}</time>
              ) : (
                <span>{item.value}</span>
              )}
              {index < meta.length - 1 && <span>&middot;</span>}
            </>
          ))}
        </div>
      )
    }

    {
      description && (
        <p
          class="text-lg leading-[calc(0.65rem+1em)] max-w-none"
          style="color: var(--color-muted-foreground);"
        >
          {description}
        </p>
      )
    }
  </header>

  <!-- Prose Content -->
  <article data-reading-target class="prose max-w-none">
    <div class="border-t border-[var(--color-border)] mb-8"></div>
    <slot />
  </article>
</section>
