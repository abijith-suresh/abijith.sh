---
interface MetaItem {
  type: "date" | "text";
  value: string;
  datetime?: string;
}

interface Props {
  /** Page title */
  title: string;
  /** Description paragraph */
  description?: string;
  /** Meta items (date, reading time, etc.) */
  meta?: MetaItem[];
  microformat?: "h-entry";
  titleClass?: string;
  class?: string;
}

const { title, description, meta, microformat, titleClass, class: className } = Astro.props;
const contentClass = microformat === "h-entry" ? "e-content" : undefined;
---

<article class:list={["detail-section", microformat, className]}>
  <!-- Header -->
  <header class="article-header rise" style="--d: 0ms">
    <h1 class:list={["article-title", titleClass]}>{title}</h1>

    {
      meta && meta.length > 0 && (
        <div class="article-meta">
          {meta.map((item, index) => (
            <>
              {item.type === "date" ? (
                <time class:list={[microformat === "h-entry" && "dt-published"]} datetime={item.datetime}>{item.value}</time>
              ) : (
                <span>{item.value}</span>
              )}
              {index < meta.length - 1 && <span aria-hidden="true">&middot;</span>}
            </>
          ))}
        </div>
      )
    }

    {
      description && (
        <p class:list={["article-lede", microformat === "h-entry" && "p-summary"]}>{description}</p>
      )
    }
  </header>

  <!-- Prose Content -->
  <div class="prose rise" style="--d: 80ms">
    <div class={contentClass}>
      <slot />
    </div>
  </div>

  <!-- Article footer -->
  <footer class="article-footer rise" style="--d: 160ms">
    <a class="all-link" href="/writing/">
      <span class="arrow" aria-hidden="true">&larr;</span> all writing
    </a>
    <p class="article-copyright">&copy; 2026 abijith s</p>
  </footer>
</article>

<style>
  .detail-section {
    margin-inline: auto;
    width: 100%;
    max-width: calc(70ch + 2 * var(--page-inline));
    padding-inline: var(--page-inline);
    padding-top: var(--page-block-start);
    padding-bottom: var(--page-block-end);
    display: flex;
    flex-direction: column;
    row-gap: var(--content-gap);
  }

  .article-header {
    display: flex;
    flex-direction: column;
    row-gap: var(--title-subtitle-gap);
  }

  .article-title {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--heading-1);
    letter-spacing: -0.015em;
    line-height: var(--leading-heading);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--spacing-3);
    row-gap: var(--spacing-1);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }

  .article-meta span[aria-hidden="true"] {
    color: var(--color-primary);
  }

  .article-lede {
    margin-top: var(--space-2xs);
    padding-left: 1.1rem;
    border-left: 2px solid oklch(70.6% 0.078 302 / 0.4);
    font-size: var(--text-lg);
    line-height: var(--leading-text);
    max-width: 52ch;
    color: var(--color-muted-foreground);
  }

  .article-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: var(--space-s);
    border-top: var(--border-width) solid var(--color-border);
  }

  .article-copyright {
    color: var(--color-muted-foreground);
    font-size: var(--text-xs);
  }

  /* the back link arrow points left — slide it left, not right */
  .article-footer .all-link:hover .arrow {
    transform: translateX(-3px);
  }
</style>
