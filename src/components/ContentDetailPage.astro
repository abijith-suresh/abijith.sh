---
import "@/styles/prose.css";
import { riseStep } from "@/lib/motion";

interface MetaItem {
  type: "date" | "text";
  value: string;
  datetime?: string;
}

interface Props {
  /** Page title */
  title: string;
  /** Description paragraph */
  description?: string;
  /** Meta items (date, reading time, etc.) */
  meta?: MetaItem[];
  microformat?: "h-entry";
  titleClass?: string;
}

const { title, description, meta, microformat, titleClass } = Astro.props;
const contentClass = microformat === "h-entry" ? "e-content" : undefined;
---

<article class:list={["container", "detail-section", microformat]}>
  <!-- Header -->
  <header class="article-header rise" style={`--d: ${riseStep(0)}`}>
    <h1 class:list={["page-title", "article-title", titleClass]}>{title}</h1>

    {
      meta && meta.length > 0 && (
        <div class="article-meta">
          {meta.map((item, index) => (
            <>
              {item.type === "date" ? (
                <time class:list={[microformat === "h-entry" && "dt-published"]} datetime={item.datetime}>{item.value}</time>
              ) : (
                <span>{item.value}</span>
              )}
              {index < meta.length - 1 && <span aria-hidden="true">&middot;</span>}
            </>
          ))}
        </div>
      )
    }

    {
      description && (
        <p class:list={["article-lede", microformat === "h-entry" && "p-summary"]}>{description}</p>
      )
    }
  </header>

  <!-- Prose Content -->
  <div class="prose rise" style={`--d: ${riseStep(1)}`}>
    <div class={contentClass}>
      <slot />
    </div>
  </div>

  <!-- Article footer -->
  <footer class="article-footer rise" style={`--d: ${riseStep(2)}`}>
    <a class="all-link" href="/writing/">
      <span class="arrow" aria-hidden="true">&larr;</span> all writing
    </a>
    <p class="article-copyright">&copy; 2026 abijith suresh</p>
  </footer>
</article>

<style>
  .detail-section {
    --container-max: calc(var(--measure-prose) + 2 * var(--page-inline));
    padding-block-start: var(--page-block-start);
    padding-block-end: var(--page-block-end);
    display: flex;
    flex-direction: column;
    row-gap: var(--content-gap);
  }

  .article-header {
    display: flex;
    flex-direction: column;
    row-gap: var(--title-subtitle-gap);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-xs);
    row-gap: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }

  .article-lede {
    margin-block-start: var(--space-2xs);
    padding-inline-start: 1.1rem;
    border-inline-start: 2px solid oklch(from var(--color-white) l c h / 0.25);
    font-size: var(--text-lg);
    line-height: var(--leading-text);
    max-width: 52ch;
    color: var(--color-muted-foreground);
  }

  .article-footer {
    --arrow-shift: -3px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .article-copyright {
    color: var(--color-muted-foreground);
    font-size: var(--text-xs);
  }
</style>
