---
interface MetaItem {
  type: "date" | "text";
  value: string;
  datetime?: string;
}

interface Props {
  /** Page title */
  title: string;
  /** Description paragraph */
  description?: string;
  /** Meta items (date, reading time, etc.) */
  meta?: MetaItem[];
  microformat?: "h-entry";
  titleClass?: string;
  class?: string;
}

const { title, description, meta, microformat, titleClass, class: className } = Astro.props;
const contentClass = microformat === "h-entry" ? "e-content" : undefined;
---

<section class:list={["detail-section", microformat, className]}>
  <!-- Header -->
  <header style="display:flex;flex-direction:column;row-gap:var(--section-gap);padding-top:var(--page-block-start)">
    <h1 class={titleClass} style="font-size:var(--heading-1);letter-spacing:0;line-height:var(--leading-heading)">
      {title}
    </h1>

    {
      meta && meta.length > 0 && (
        <div
          style="display:flex;flex-wrap:wrap;align-items:center;column-gap:var(--spacing-3);row-gap:var(--spacing-1);font-size:var(--text-sm);color:var(--color-muted-foreground)"
        >
          {meta.map((item, index) => (
            <>
              {item.type === "date" ? (
                <time class:list={[microformat === "h-entry" && "dt-published"]} datetime={item.datetime}>{item.value}</time>
              ) : (
                <span>{item.value}</span>
              )}
              {index < meta.length - 1 && <span>&middot;</span>}
            </>
          ))}
        </div>
      )
    }

    {
      description && (
        <p
          class:list={[microformat === "h-entry" && "p-summary"]}
          style="font-size:var(--text-lg);line-height:var(--leading-text);max-width:none;color:var(--color-muted-foreground)"
        >
          {description}
        </p>
      )
    }
  </header>

  <!-- Prose Content -->
  <article class="prose" style="max-width:none">
    <div style="border-top:var(--border-width) solid var(--color-border);margin-bottom:var(--content-gap)"></div>
    <div class={contentClass}>
      <slot />
    </div>
  </article>
</section>

<style>
  .detail-section {
    margin-inline: auto;
    width: 100%;
    max-width: var(--measure);
    padding-inline: var(--page-inline);
    display: flex;
    flex-direction: column;
    row-gap: var(--content-gap);
    padding-bottom: var(--page-block-end);
  }
</style>
