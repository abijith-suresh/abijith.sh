---
interface MetaItem {
  type: "date" | "text";
  value: string;
  datetime?: string;
}

interface Props {
  /** Page title */
  title: string;
  /** Description paragraph */
  description?: string;
  /** Meta items (date, reading time, etc.) */
  meta?: MetaItem[];
  class?: string;
}

const { title, description, meta, class: className } = Astro.props;
---

<section class:list={["detail-section", className]}>
  <!-- Header -->
  <header style="display:flex;flex-direction:column;row-gap:1.25rem;padding-top:var(--spacing-4)">
    <h1 style="font-size:clamp(2rem,4.5vw,3.5rem);font-weight:500;letter-spacing:-0.025em;line-height:1.25">
      {title}
    </h1>

    {
      meta && meta.length > 0 && (
        <div
          style="display:flex;flex-wrap:wrap;align-items:center;column-gap:var(--spacing-3);row-gap:var(--spacing-1);font-size:var(--text-sm);color:var(--color-muted-foreground)"
        >
          {meta.map((item, index) => (
            <>
              {item.type === "date" ? (
                <time datetime={item.datetime}>{item.value}</time>
              ) : (
                <span>{item.value}</span>
              )}
              {index < meta.length - 1 && <span>&middot;</span>}
            </>
          ))}
        </div>
      )
    }

    {
      description && (
        <p
          style="font-size:var(--text-lg);line-height:calc(0.65rem+1em);max-width:none;color:var(--color-muted-foreground)"
        >
          {description}
        </p>
      )
    }
  </header>

  <!-- Prose Content -->
  <article class="prose" style="max-width:none">
    <div style="border-top:var(--border-width)solid var(--color-border);margin-bottom:var(--spacing-8)"></div>
    <slot />
  </article>
</section>

<style>
  .detail-section {
    margin-inline: auto;
    width: 100%;
    max-width: 640px;
    padding-inline: var(--spacing-6);
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-8);
    padding-bottom: var(--spacing-16);
  }
</style>
