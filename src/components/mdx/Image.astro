---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
}

const { src, alt, caption, class: className } = Astro.props;
---

<figure class:list={cn("my-6", className)}>
  <Image src={src} alt={alt} class="w-full border border-border" loading="lazy" decoding="async" />
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-muted-foreground">{caption}</figcaption>
    )
  }
</figure>
