---
import type { MarkdownHeading } from "astro";
import TOCList from "@/components/TOCList.astro";
import { cn } from "@/lib/utils";

interface Props {
  headings: MarkdownHeading[];
  class?: string;
}

const { headings, class: className } = Astro.props;
---

{
  headings.length > 0 && (
    <div
      id="toc-sidebar-container"
      class:list={cn(
        "sticky top-20 col-start-1 row-span-1 mr-8 ml-auto hidden h-[calc(100vh-5rem)] max-w-64 lg:block",
        className
      )}
    >
      <div class="flex max-h-[calc(100vh-8rem)] flex-col overflow-y-auto pr-4">
        <span class="eyebrow mb-4">On this page</span>
        <TOCList
          headings={headings}
          listId="toc-sidebar-list"
          linkClass="toc-sidebar-link transition-all duration-200"
          dataAttr="data-heading-link"
        />
      </div>
    </div>
  )
}

<script>
  import { attachTocLifecycle, createDesktopTocController } from "@/lib/toc";

  const controller = createDesktopTocController({
    headingSelector: ".prose h2[id], .prose h3[id]",
    headerOffset: 100,
    containerSelector: "#toc-sidebar-container",
    linkSelector: "[data-heading-link]",
    activeClass: "active",
    enableSmoothScroll: true,
  });

  attachTocLifecycle(controller);
</script>
